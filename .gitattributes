# ===================================================================
# Project_KN .gitattributes
#  - Unity YAML: 텍스트 + UnityYAMLMerge(Smart Merge) 대상
#  - 바이너리 에셋: Git LFS
# ===================================================================
* text=auto

# ---- Code / Text ----
*.cs     text diff=csharp eol=lf
*.shader text eol=lf
*.hlsl   text eol=lf
*.cginc  text eol=lf
*.json   text eol=lf
*.csv    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.asmdef text eol=lf
*.uxml   text eol=lf
*.uss    text eol=lf

# ---- Unity YAML (Smart Merge) ----
*.unity          merge=unityyamlmerge eol=lf linguist-generated
*.prefab         merge=unityyamlmerge eol=lf linguist-generated
*.asset          merge=unityyamlmerge eol=lf linguist-generated
*.mat            merge=unityyamlmerge eol=lf linguist-generated
*.anim           merge=unityyamlmerge eol=lf linguist-generated
*.controller     merge=unityyamlmerge eol=lf linguist-generated
*.overrideController merge=unityyamlmerge eol=lf linguist-generated
*.physicMaterial merge=unityyamlmerge eol=lf linguist-generated
*.physicsMaterial2D merge=unityyamlmerge eol=lf linguist-generated
*.playable       merge=unityyamlmerge eol=lf linguist-generated
*.mask           merge=unityyamlmerge eol=lf linguist-generated
*.brush          merge=unityyamlmerge eol=lf linguist-generated
*.flare          merge=unityyamlmerge eol=lf linguist-generated
*.spriteatlas    merge=unityyamlmerge eol=lf linguist-generated
*.spriteatlasv2  merge=unityyamlmerge eol=lf linguist-generated
*.meta           merge=unityyamlmerge eol=lf

# ---- Image ----
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.psb  filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.ai   filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.ase  filter=lfs diff=lfs merge=lfs -text

# ---- Audio ----
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.bank filter=lfs diff=lfs merge=lfs -text

# ---- Video ----
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# ---- 3D / Spine / Font ----
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.skel  filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
# TMP 폰트 SDF 에셋 (D-16): 아틀라스가 커서 YAML 병합 대신 LFS
Assets/_Project/Fonts/*SDF.asset filter=lfs diff=lfs merge=lfs -text

# ---- Native / Archive ----
*.dll   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
*.aar   filter=lfs diff=lfs merge=lfs -text
*.jar   filter=lfs diff=lfs merge=lfs -text
*.zip   filter=lfs diff=lfs merge=lfs -text
*.7z    filter=lfs diff=lfs merge=lfs -text

# ---- 기획 원본 문서 (바이너리) ----
*.xlsx  filter=lfs diff=lfs merge=lfs -text
*.pptx  filter=lfs diff=lfs merge=lfs -text
*.docx  filter=lfs diff=lfs merge=lfs -text
*.pdf   filter=lfs diff=lfs merge=lfs -text
