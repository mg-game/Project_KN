  lineages:
  - id: jjakjjak
    name: "\uC9DD\uC9DD\uC774"
    species: "\uC591\uB9D0\uC871"
    origin: "\uC9DD\uC744 \uC783\uC740 \uC591\uB9D0"
    personality: "\uC9DD\uC744 \uC783\uC740 \uC591\uB9D0\uC774\uB77C, \uB2E4\uB978
      \uC591\uB9D0\uB9CC \uBCF4\uBA74 \uBB34\uC870\uAC74 \uAC00\uC871\uC774\uB77C\uACE0
      \uBD88\uB7EC\uC694. \uBE68\uB798 \uBC14\uAD6C\uB2C8 \uC18D \uB0AF\uC120 \uC591\uB9D0\uC5D0\uAC8C\uB3C4,
      \uAE38\uAC00\uC5D0 \uB5A8\uC5B4\uC9C4 \uC544\uAE30 \uC591\uB9D0\uC5D0\uAC8C\uB3C4
      \uBA3C\uC800 \uC190\uC744 \uD754\uB4E4\uBA70 \"\uC6B0\uB9AC \uC2DD\uAD6C!\"
      \uD558\uACE0 \uBC18\uAE30\uC9C0\uC694.\n\uD55C \uC9DD\uB9CC \uB0A8\uC740 \uC678\uB85C\uC6C0\uC744
      \uB204\uAD6C\uBCF4\uB2E4 \uC798 \uC54C\uAE30\uC5D0, \uD63C\uC790 \uB0A8\uC740
      \uCE5C\uAD6C\uB97C \uC808\uB300 \uADF8\uB0E5 \uC9C0\uB098\uCE58\uC9C0 \uBABB\uD574\uC694.
      \uBCF4\uB77C \uB2E8\uCD94 \uB208\uACFC \uBC14\uB298\uB540 \uB208\uC73C\uB85C
      \uC6C3\uB294 \uC5BC\uAD74\uC740, \uADF8\uB798\uC11C \uB298 \uC870\uAE08 \uC9DD\uC9DD\uC774\uB78D\uB2C8\uB2E4."
    grade: 2
    bodyType: 1
    traits: 0000000004000000
    mainColor: {r: 0.9529412, g: 0.9019608, b: 0.8156863, a: 1}
    subColor: {r: 0.5411765, g: 0.3882353, b: 0.7882353, a: 1}
    accentColor: {r: 0.90588236, g: 0.60784316, b: 0.72156864, a: 1}
    neutralColor: {r: 0.56078434, g: 0.72156864, b: 0.87058824, a: 1}
    baseFormId: jjak_base
    forms:
    - id: jjak_base
      name: "\uC9DD\uC9DD\uC774"
      parentFormId: 
      tier: 0
      style: 0
      recommendedRole: 0
      description: "\uB2C8\uD2B8 \uC591\uB9D0\uC758 \uBC1C\uBAA9\uC774 \uBAA9\uC774
        \uB418\uACE0, \uB465\uADFC \uB4A4\uAFC8\uCE58\uAC00 \uB4F1\uC774 \uB418\uACE0,
        \uBCF4\uB77C\uC0C9 \uCEE4\uD504\uB294 \uBAA8\uC790\uCC98\uB7FC \uBA38\uB9AC
        \uC704\uC5D0 \uC5B9\uD614\uC5B4\uC694. \uC9E7\uC740 \uD314\uB2E4\uB9AC\uB294
        \uBC1C\uAC00\uB77D \uC194\uAE30\uB97C \uAFF0\uB9E4\uC5B4 \uB9CC\uB4E0 \uAC70\uC608\uC694.\n\uD3ED\uC2E0\uD55C
        \uBAB8\uC73C\uB85C \uC218\uC120\uC810 \uC55E\uC744 \uB9C9\uC544\uC11C\uBA74,
        \uBAB8\uC5D0 \uC77C\uC5B4\uB09C \uBCF4\uD480\uC774 \uB2E4\uAC00\uC624\uB294
        \uC801\uC758 \uBC1C\uC744 \uBD99\uC7A1\uC544 \uB290\uB9AC\uAC8C \uB9CC\uB4E4\uC5B4\uC694."
      portrait: {fileID: 21300000, guid: 4c424f5eaecfa194fb4d835df27e8e3d, type: 3}
      skill:
        id: skill_jjak_base
        name: "\uAC00\uC871 \uBD80\uB974\uAE30"
        description: "\uC9DD\uC744 \uC783\uC740 \uC591\uB9D0\uC774\uB77C \uB2E4\uB978
          \uC591\uB9D0\uB9CC \uBCF4\uBA74 \uBB34\uC870\uAC74 \uAC00\uC871\uC774\uB77C\uACE0
          \uBD88\uB7EC\uC694. \"\uC6B0\uB9AC \uC2DD\uAD6C!\" \uD558\uACE0 \uC678\uCE58\uBA74
          \uAE38 \uC783\uC740 \uC544\uAE30 \uC591\uB9D0\uB4E4\uC774 \uCABC\uB974\uB974
          \uB2EC\uB824\uC640\uC694.\n16\uCD08\uB9C8\uB2E4 \uB2A5\uB825\uCE58 40%\uC758
          \uC791\uC740 \uCE5C\uAD6C 2\uB9C8\uB9AC\uB97C \uBD88\uB7EC 8\uCD08 \uB3D9\uC548
          \uD568\uAED8 \uC2F8\uC6CC\uC694."
        castText: "\uC6B0\uB9AC \uC2DD\uAD6C, \uBAA8\uC5EC\uB77C!"
        trigger: 1
        cooldown: 16
        initialDelay: 5
        target: 0
        radius: 0.6
        effects:
        - type: 10
          value: 0.4
          duration: 8
          count: 2
        vfx: vfx_summon_circle
      attack: 12
      hp: 201
      attackInterval: 1
      range: 1.5
      arcDegrees: 80
      moveSpeed: 0.7
      summonCost: 5
      lifetime: 14
      clueLevel: 0
      materials: []
      conditions: []
    - id: jjak_caravan
      name: "\uC591\uB9D0 \uCE74\uB77C\uBC18"
      parentFormId: jjak_base
      tier: 1
      style: 0
      recommendedRole: 0
      description: "\uAE38\uC744 \uC783\uC740 \uC9DD \uC591\uB9D0\uB4E4\uC774 \uD558\uB098\uB458
        \uC9DD\uC9DD\uC774\uC5D0\uAC8C \uC774\uC5B4 \uBD99\uC5B4, \uBAB8\uC774 \uB9C8\uB514\uB9C8\uB514
        \uBC29\uC774 \uB2EC\uB9B0 \uAE34 \uC774\uB3D9\uC9D1\uC774 \uB418\uC5C8\uC5B4\uC694.
        \uB9C8\uB514\uB9C8\uB2E4 \uB465\uADFC \uCC3D\uBB38\uC774 \uB098\uACE0, \uBC1C\uBC14\uB2E5
        \uB300\uC2E0 \uC2E4\uBB49\uCE58 \uBC14\uD034\uAC00 \uB370\uAD74\uB370\uAD74
        \uAD74\uB7EC\uAC00\uC694.\n\uC9C0\uD0B4\uC774\uB85C \uC11C\uBA74 \uAE34 \uBAB8\uC73C\uB85C
        \uBC29\uC704\uB97C \uBE59 \uB458\uB7EC \uAC10\uC2F8, \uC801\uC758 \uBC1C\uAC78\uC74C\uC744
        \uB2A6\uCD94\uB294 \uB2E8\uB2E8\uD55C \uBC29\uBCBD\uC774 \uB3FC\uC694."
      portrait: {fileID: 21300000, guid: 6b7abcf2e87313a449ec0e8eb1d345e2, type: 3}
      skill:
        id: skill_jjak_caravan
        name: "\uC2DD\uAD6C \uC5F4\uCC28"
        description: "\uAC00\uC871 \uBD80\uB974\uAE30\uAC00 \uC774\uB3D9\uC9D1\uC774
          \uB418\uC5C8\uC5B4\uC694. \uC218\uC120\uC810\uC774 \uD754\uB4E4\uB9AC\uBA74
          \uB9C8\uB514\uB9C8\uB514 \uBC29\uC5D0 \uC0B4\uB358 \uC9DD \uC591\uB9D0
          \uC2DD\uAD6C\uB4E4\uC774 \uCC3D\uBB38\uC744 \uC5F4\uACE0 \uC6B0\uB974\uB974
          \uB6F0\uC5B4\uB098\uC640\uC694.\n\uC218\uC120\uC810\uC774 \uACF5\uACA9\uBC1B\uC73C\uBA74(14\uCD08\uC5D0
          \uD55C \uBC88\uAE4C\uC9C0) \uB2A5\uB825\uCE58 50%\uC758 \uC791\uC740 \uCE5C\uAD6C
          3\uB9C8\uB9AC\uB97C \uBD88\uB7EC 9\uCD08 \uB3D9\uC548 \uD568\uAED8 \uC2F8\uC6CC\uC694."
        castText: "\uC2DD\uAD6C\uB4E4, \uBB38 \uC5F4\uC5B4!"
        trigger: 6
        cooldown: 14
        initialDelay: 0
        target: 0
        radius: 0.6
        effects:
        - type: 10
          value: 0.5
          duration: 9
          count: 3
        vfx: vfx_summon_circle
      attack: 16.3
