      name: "\uBC24\uC9C0\uAE30 \uC9DD\uC9DD\uC774"
      emotion: "\uC678\uB85C\uC6C0 \u2192 \uC704\uB85C"
      description: "\uC9DD\uC9DD\uC774\uB294 \uC218\uB9CE\uC740 \uC678\uB85C\uC6B4
        \uBC24\uC744 \uC218\uC120\uC9D1 \uCC3D\uAC00\uC5D0\uC11C \uBCF4\uB0C8\uC5B4\uC694.
        \uAE34 \uBC24\uC774 \uCC3E\uC544\uC640\uB3C4 \uC9DD\uC744 \uAE30\uB2E4\uB9AC\uB294
        \uC77C\uC744 \uD3EC\uAE30\uD558\uC9C0 \uC54A\uC558\uC9C0\uC694.\n\uB9C8\uC744
        \uC0AC\uB78C\uB4E4\uC740 \uADF8\uAC00 \uC7A0\uB4E4\uC9C0 \uC54A\uACE0 \uC9C0\uCF1C\uBCFC
        \uC218 \uC788\uB3C4\uB85D \uB2EC\uACFC \uBCC4 \uC870\uAC01\uC744 \uAFF0\uB9E4\uC5B4
        \uC8FC\uC5C8\uACE0, \uC9DD\uC9DD\uC774\uB294 \uB354\uC6B1 \uBC1D\uAC8C \uBE5B\uB0A0
        \uC218 \uC788\uC5C8\uC5B4\uC694. \uB2EC \uC7A5\uC2DD\uC774 \uB2EC\uB9B0 \uBC24\uBAA8\uC790\uB294
        \uC9DD\uC9DD\uC774\uAC00 \uBC24\uC744 \uC9C0\uCF1C\uBCF4\uB294 \uD798\uC774
        \uB418\uC5B4 \uC918\uC694.\n\uADF8\uB807\uAC8C \uC9DD\uC9DD\uC774\uB294 \uC790\uC2E0\uC758
        \uC678\uB85C\uC6C0\uC744, \uC0C8\uB85C \uCC3E\uC544\uC628 \uC678\uB85C\uC6B4
        \uC544\uC774\uB4E4\uC744 \uB530\uB73B\uD558\uAC8C \uB9DE\uC774\uD558\uACE0
        \uC9C0\uCF1C \uC8FC\uB294 \uBC24\uC9C0\uAE30\uB85C \uBC14\uAFB8\uC5C8\uB2F5\uB2C8\uB2E4."
      acquisition: "\uC218\uC120\uC9D1 \uC57C\uAC04 \uBC29\uBB38(\uBC24 8\uC2DC ~
        \uC0C8\uBCBD 6\uC2DC \uC811\uC18D)\uC73C\uB85C \uB9CC\uB098 \uBCF4\uC138\uC694!"
      unlockType: 1
      unlockTarget: 0
      unlockTargetId: 
      price: 0
      attackBonusPercent: 4
      portrait: {fileID: 21300000, guid: a808c6ed434514c46a30479310b7da0d, type: 3}
      illustration: {fileID: 21300000, guid: d46fd9510ba75dc428e51b723570032d, type: 3}
    - id: jjak_cheer
      name: "\uC751\uC6D0\uB300\uC7A5 \uC9DD\uC9DD\uC774"
      emotion: "\uB450\uB824\uC6C0 \u2192 \uC6A9\uAE30"
      description: "\uC0C8\uB85C \uC0B4\uC544\uB09C \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C
        \uCCAB \uBC24\uC740 \uB298 \uBB34\uC11C\uC6CC\uC694. \uC9DD\uC9DD\uC774\uB3C4
        \uCC98\uC74C\uC5D4 \uADF8\uB7AC\uC9C0\uC694.\n\uADF8\uB798\uC11C \uC9DD\uC9DD\uC774\uB294
        \uBCF4\uB77C\uC0C9 \uCEE4\uD504\uB97C \uAE43\uBC1C \uBAA8\uC790\uCC98\uB7FC
        \uB192\uC774 \uC138\uC6B0\uACE0, \uD480\uB9B0 \uD138\uC2E4\uC744 \uB3D9\uAE00\uB3D9\uAE00
        \uBB49\uCCD0 \uC751\uC6D0 \uBC29\uC6B8\uC744 \uB2EC\uC558\uC5B4\uC694. \uB0AF\uC120
        \uCE5C\uAD6C\uC5D0\uAC8C \uAC00\uC7A5 \uBA3C\uC800 \uC190\uC744 \uD754\uB4DC\uB294
        \uCABD\uC774 \uB418\uAE30\uB85C \uD55C \uAC70\uC608\uC694.\n\"\uAD1C\uCC2E\uC544,
        \uBB34\uC11C\uC6B0\uBA74 \uB0B4 \uC190 \uC7A1\uC544! \uD558\uB098, \uB458,
        \uC14B, \uAC19\uC774 \uAC00\uC790!\""
      acquisition: "\uC2A4\uD14C\uC774\uC9C0 2-4\uB97C \uD074\uB9AC\uC5B4\uD558\uBA74
        \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694."
      unlockType: 3
      unlockTarget: 15
      unlockTargetId: 
      price: 0
      attackBonusPercent: 3
      portrait: {fileID: 21300000, guid: 1da29e265724bfc4292c87cdfa618bfc, type: 3}
      illustration: {fileID: 0}
    - id: jjak_mail
      name: "\uC6B0\uD3B8\uBC30\uB2EC \uC9DD\uC9DD\uC774"
      emotion: "\uB2E8\uC808 \u2192 \uC5F0\uACB0"
      description: "\uC9DD\uC744 \uAE30\uB2E4\uB9AC\uB294 \uB3D9\uC548 \uC9DD\uC9DD\uC774\uB294
        \uB9E4\uC77C \uD3B8\uC9C0\uB97C \uC37C\uC5B4\uC694. \uBD80\uCE60 \uACF3\uC744
        \uBAB0\uB77C \uC591\uB9D0 \uC18D\uC5D0 \uCC28\uACE1\uCC28\uACE1 \uC313\uC544
        \uB450\uAE30\uB9CC \uD588\uC9C0\uC694.\n\uC5B4\uB290 \uB0A0 \uC9DD\uC9DD\uC774\uB294
        \uAE68\uB2EC\uC558\uC5B4\uC694. \uC804\uD558\uC9C0 \uBABB\uD55C \uB9C8\uC74C\uC744
        \uD488\uC740 \uAC74 \uC790\uAE30\uB9CC\uC774 \uC544\uB2C8\uB77C\uB294 \uAC78\uC694.
        \uC774\uC81C \uC9DD\uC9DD\uC774\uB294 \uC6B0\uD3B8\uBC30\uB2EC \uBAA8\uC790\uB97C
        \uC4F0\uACE0, \uC591\uB9D0 \uC18D \uAE4A\uC740 \uC8FC\uBA38\uB2C8\uC5D0 \uBAA8\uB450\uC758
        \uD3B8\uC9C0\uB97C \uB2F4\uC544 \uB04A\uC5B4\uC9C4 \uB9C8\uC74C\uC744 \uC774\uC5B4
        \uC8FC\uB7EC \uB5A0\uB098\uC694.\n\"\uBC1B\uB294 \uC0AC\uB78C\uC774 \uC5C6\uB294
        \uD3B8\uC9C0\uB294 \uC5C6\uC5B4\uC694. \uC544\uC9C1 \uBABB \uCC3E\uC558\uC744
        \uBFD0\uC774\uC5D0\uC694.\""
      acquisition: "\uC9DD\uC9DD\uC774 \uACC4\uBCF4\uB85C \uC6D0\uC815\uC744 5\uD68C
        \uC644\uB8CC\uD558\uBA74 \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694."
      unlockType: 4
      unlockTarget: 5
      unlockTargetId: 
      price: 0
      attackBonusPercent: 3
      portrait: {fileID: 21300000, guid: 8216f0cc296687841b57d95641dadab9, type: 3}
      illustration: {fileID: 0}
    - id: jjak_traveler
      name: "\uC5EC\uD589\uC790 \uC9DD\uC9DD\uC774"
      emotion: "\uAE30\uB2E4\uB9BC \u2192 \uD0D0\uC0C9"
      description: "\uCC3D\uAC00\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uAE30\uB9CC \uD558\uB358
        \uC9DD\uC9DD\uC774\uAC00 \uCC98\uC74C\uC73C\uB85C \uC218\uC120\uC810 \uBB38\uC744
        \uC5F4\uACE0 \uB098\uC130\uC5B4\uC694. \uB0A1\uC740 \uC5EC\uD589 \uAC00\uBC29\uC5D0
        \uC9C0\uB3C4\uC640 \uC2E4\uBB49\uCE58, \uC791\uC740 \uB79C\uD134\uC744 \uCC59\uACA8\uC11C\uC694.\n\uC544\uC9C1
        \uC544\uBB34\uB3C4 \uCC3E\uC9C0 \uBABB\uD55C \uCE5C\uAD6C\uB4E4\uC774 \uC5B4\uB518\uAC00\uC5D0\uC11C
        \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744 \uD14C\uB2C8\uAE4C\uC694. \uC9DD\uC9DD\uC774\uAC00
        \uC9C0\uB098\uAC04 \uAE38\uC5D0\uB294, \uB3CC\uC544\uC624\uB294 \uAE38\uC744
        \uC783\uC9C0 \uC54A\uB3C4\uB85D \uC2E4 \uD55C \uAC00\uB2E5\uC774 \uAE38\uAC8C
        \uB0A8\uC544\uC694.\n\"\uAE30\uB2E4\uB9AC\uB294 \uAC83\uB3C4 \uC88B\uC9C0\uB9CC,
        \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uBA3C\uC800 \uCC3E\uC73C\uB7EC \uAC08\uB798!\""
      acquisition: "\uC9DD\uC9DD\uC774 \uACC4\uBCF4\uB85C \uC6D0\uC815\uC744 15\uD68C
        \uC644\uB8CC\uD558\uBA74 \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694."
      unlockType: 4
      unlockTarget: 15
      unlockTargetId: 
      price: 0
      attackBonusPercent: 4
      portrait: {fileID: 21300000, guid: 129fa3f8a6d10c644860382eeeb53648, type: 3}
      illustration: {fileID: 0}
    - id: jjak_festival
      name: "\uCD95\uC81C \uC9C0\uD718\uC790 \uC9DD\uC9DD\uC774"
      emotion: "\uC678\uB85C\uC6C0 \u2192 \uCD95\uC81C"
      description: "\uD63C\uC790\uC600\uB358 \uC9DD\uC9DD\uC774 \uACC1\uC5D0 \uD558\uB098\uB458
        \uCE5C\uAD6C\uB4E4\uC774 \uBAA8\uC774\uC790, \uC218\uC120\uC810 \uACE8\uBAA9\uC740
        \uC5B4\uB290\uC0C8 \uC791\uC740 \uCD95\uC81C\uAC00 \uB418\uC5C8\uC5B4\uC694.\n\uC9DD\uC9DD\uC774\uB294
        \uBCC4 \uC7A5\uC2DD \uC9C0\uD718\uBD09\uC744 \uB4E4\uACE0 \uD37C\uB808\uC774\uB4DC
        \uB9E8 \uC55E\uC5D0 \uC130\uC5B4\uC694. \uC9DD\uC744 \uC783\uC740 \uC591\uB9D0\uB3C4,
        \uB5A8\uC5B4\uC9C4 \uB2E8\uCD94\uB3C4, \uB2E4 \uD0C0 \uBC84\uB9B0 \uCD08\uB3C4
        \uBAA8\uB450 \uD55C \uC904\uB85C \uC774\uC5B4 \uAC77\uB294 \uBC24\uC744 \uC704\uD574\uC11C\uC694.\n\"\uC790,
        \uB2E4 \uAC19\uC774! \uC624\uB298 \uBC24\uC740 \uC544\uBB34\uB3C4 \uD63C\uC790\uAC00
        \uC544\uB2C8\uC57C!\""
      acquisition: "'\uBCC4\uC774 \uBA38\uBB38 \uBC24 \uC0B0\uCC45' \uC774\uBCA4\uD2B8
        \uC0C1\uC810\uC5D0\uC11C \uBCC4\uBE5B \uC0AC\uD0D5 300\uAC1C\uB85C \uAD50\uD658\uD560
        \uC218 \uC788\uC5B4\uC694."
      unlockType: 2
      unlockTarget: 0
      unlockTargetId: 
      price: 300
      attackBonusPercent: 6
      portrait: {fileID: 21300000, guid: 608df54c3c5c55f4b8cdacf5f05af700, type: 3}
      illustration: {fileID: 0}
    - id: jjak_caterpillar
      name: "\uC560\uBC8C\uB808\uD615 \uC774\uB3D9\uC9D1 \uC9DD\uC9DD\uC774"
      emotion: "\uC791\uC740 \uC678\uB85C\uC6C0 \u2192 \uD568\uAED8 \uAC00\uB294
        \uC5EC\uD589"
      description: "\uC5EC\uB7EC \uCE5C\uAD6C\uB4E4\uC744 \uC2E3\uACE0 \uAE30\uC5B4\uAC00\uB294
        \uC774\uB3D9\uC2DD \uC9D1\uC774 \uB41C \uC9DD\uC9DD\uC774\uC608\uC694.\n\uB9CE\uC740
        \uC9DD \uC591\uB9D0\uB4E4\uC774 \uBAA8\uC5EC \uB290\uC2A8\uD558\uAC8C \uC774\uC5B4\uC9C0\uBA74\uC11C,
        \uBAA8\uB450\uC758 \uBCF4\uAE08\uC790\uB9AC\uAC00 \uB418\uB294 \uC5EC\uD589\uD558\uB294
        \uC9D1\uC774 \uB418\uC5C8\uC5B4\uC694. \uB9C8\uB514\uB9C8\uB2E4 \uAC01\uC790\uC758
        \uBC29\uC774 \uC788\uACE0, \uC544\uB291\uD55C \uCD9C\uC785\uAD6C\uC640 \uB530\uB73B\uD55C
        \uB79C\uD134\uC774 \uCE5C\uAD6C\uB4E4\uC744 \uB9DE\uC774\uD574\uC694.\n\uC791\uC740
        \uC678\uB85C\uC6C0\uB3C4 \uC5F0\uACB0\uB418\uBA74, \uC138\uC0C1\uC744 \uBC14\uAFB8\uB294
        \uCD95\uC81C\uAC00 \uB41C\uB2F5\uB2C8\uB2E4!"
      acquisition: "\uC9C4\uD654\uD615 '\uC591\uB9D0 \uCE74\uB77C\uBC18' \uD574\uAE08
        \uC2DC \uD568\uAED8 \uC5F4\uB824\uC694."
      unlockType: 6
      unlockTarget: 0
      unlockTargetId: jjak_caravan
      price: 0
      attackBonusPercent: 6
      portrait: {fileID: 21300000, guid: 5b84703b6d79e5c4ba6f76dddd8a55ed, type: 3}
      illustration: {fileID: 21300000, guid: d987606d80fd26749bdc73a90a8a5018, type: 3}
    - id: jjak_plush
      name: "\uBD09\uC81C\uCE5C\uAD6C \uC9DD\uC9DD\uC774"
      emotion: "\uD145 \uBE54 \u2192 \uB098\uB214"
      description: "\uC9DD\uC9DD\uC774\uAC00 \uC774\uC81C \uC791\uC740 \uCE5C\uAD6C\uB4E4\uC744
        \uC548\uACE0, \uB9CC\uB4E4\uC5B4 \uC918\uC694.\n\uD145 \uBE44\uC5C8\uB358
        \uBAB8 \uC548\uC5D0 \uC19C\uACFC \uCC9C \uC870\uAC01, \uB530\uB73B\uD55C
        \uB9C8\uC74C\uC744 \uCC44\uC6CC \uB123\uACE0, \uBC14\uB298\uACFC \uC2E4\uB85C
        \uC791\uC740 \uBD09\uC81C \uCE5C\uAD6C\uB4E4\uC744 \uD558\uB098\uB458 \uC9C0\uC5B4
        \uC8FC\uC5C8\uC5B4\uC694. \uD63C\uC790\uC600\uB358 \uC9DD\uC9DD\uC774\uAC00
        \uC774\uC81C\uB294 \uD568\uAED8\uD558\uB294 \uAE30\uC068\uC744 \uB098\uB220\uC694.\n\uC791\uC740
        \uCC9C \uC870\uAC01\uB3C4, \uC678\uB85C\uC6B4 \uB9C8\uC74C\uB3C4 \uC0AC\uB791\uC73C\uB85C
        \uC774\uC5B4\uC9C0\uBA74 \uCE5C\uAD6C\uAC00 \uB420 \uC218 \uC788\uC5B4\uC694."
      acquisition: "\uC9DD\uC9DD\uC774 \uACC4\uBCF4 \uACF5\uBA85 Lv.3 \uB2EC\uC131
        \uC2DC \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694."
      unlockType: 5
      unlockTarget: 3
      unlockTargetId: 
      price: 0
      attackBonusPercent: 5
      portrait: {fileID: 21300000, guid: 3bcedbe9ea33caf409f953155237f55c, type: 3}
      illustration: {fileID: 21300000, guid: d5424cb3323c4664da039169d15e8cde, type: 3}
    - id: jjak_puppet
      name: "\uC190\uC778\uD615 \uC9DD\uC9DD\uC774"
      emotion: "\uC678\uB85C\uC6C0 \u2192 \uC6C3\uC74C"
      description: "\uC190\uC5D0 \uB07C\uC6B0\uAE30 \uC26C\uC6B4 \uC591\uB9D0\uC758
        \uAD6C\uC870\uB97C \uC774\uC57C\uAE30\uB97C \uC804\uD558\uB294 \uC190\uC778\uD615\uC73C\uB85C
        \uBC14\uAFB8\uC5B4, \uC9DD\uC9DD\uC774\uB9CC\uC758 \uC7A5\uC810\uC778 '\uD568\uAED8\uD558\uB294
        \uC990\uAC70\uC6C0'\uC744 \uB354\uC6B1 \uD0A4\uC6E0\uC5B4\uC694.\n\uC785\uC744
        \uD06C\uAC8C \uBC8C\uB838\uB2E4 \uB2EB\uC73C\uBA70 \uC5EC\uB7EC \uBAA9\uC18C\uB9AC\uB85C
        \uB3D9\uD654\uC640 \uB178\uB798\uB97C \uB4E4\uB824\uC8FC\uACE0, \uB9AC\uBCF8\uACFC
        \uCEE4\uD2BC\uC73C\uB85C \uAFB8\uBBFC \uC791\uC740 \uADF9\uC7A5\uC5D0\uC11C
        \uC678\uB85C\uC6B4 \uC544\uC774\uB4E4\uC758 \uB9C8\uC74C\uC744 \uC6C3\uAC8C
        \uB9CC\uB4E4\uC5B4\uC694. \uC624\uB298\uC758 \uC774\uC57C\uAE30\uB294 \uC6A9\uAE30,
        \uC6B0\uC815, \uADF8\uB9AC\uACE0 \uAFC8\uC774\uC5D0\uC694.\n\"\uC790, \uBAA8\uB450
        \uBAA8\uC5EC \uBD10~ \uC774\uC57C\uAE30 \uD55C \uD3B8 \uB4E4\uB824\uC904\uAC8C!\""
      acquisition: "\uC2A4\uD14C\uC774\uC9C0 3-9\uB97C \uD074\uB9AC\uC5B4\uD558\uBA74
        \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694."
      unlockType: 3
      unlockTarget: 30
      unlockTargetId: 
      price: 0
      attackBonusPercent: 5
      portrait: {fileID: 21300000, guid: 1a7679f886c945f4fa62a7f5a00e4bfe, type: 3}
      illustration: {fileID: 21300000, guid: cd7b272662be56243932394b9371952c, type: 3}
    - id: jjak_sleepcap
      name: "\uC218\uBA74\uBAA8\uC790 \uC9DD\uC9DD\uC774"
      emotion: "\uBD88\uC548 \u2192 \uC548\uC2EC"
      description: "\uC9DD\uC9DD\uC774\uAC00 \uC218\uBA74\uBAA8\uC790 \uBAA8\uC591\uC758
        \uBC24\uC9C0\uAE30\uAC00 \uB418\uC5B4, \uC678\uB85C\uC6B4 \uBC24\uC744 \uC9C0\uCF1C\uBD10\uC694.\n\uC591\uB9D0\uC758
        \uAE34 \uD615\uD0DC\uC640 \uBD80\uB4DC\uB7EC\uC6B4 \uBC34\uB4DC\uB97C \uC218\uBA74\uBAA8\uC790\uB85C
        \uBC14\uAFB8\uC5B4, \uC7A0\uB4E0 \uC544\uC774\uB4E4\uC744 \uC9C0\uCF1C \uC8FC\uB294
        \uBC24\uC9C0\uAE30\uB85C \uB2E4\uC2DC \uD0DC\uC5B4\uB0AC\uC5B4\uC694. \uB2EC\uBE5B
        \uB4DC\uB9BC \uB79C\uD134\uACFC \uAFC8 \uBCA0\uAC1C\uB97C \uACC1\uC5D0 \uB450\uACE0,
        \uBCC4\uACFC \uB2EC \uC7A5\uC2DD\uC774 \uD754\uB4E4\uB9B4 \uB54C\uB9C8\uB2E4
        \uBD88\uC548\uD55C \uB9C8\uC74C\uC774 \uC870\uC6A9\uD788 \uAC00\uB77C\uC549\uC544\uC694.\n\"\uC27F\u2026
        \uC798 \uC790\uC694. \uC9DD\uC9DD\uC774\uAC00 \uC788\uC796\uC544\uC694.\""
      acquisition: "'\uBCC4\uC774 \uBA38\uBB38 \uBC24 \uC0B0\uCC45' \uC774\uBCA4\uD2B8
        \uC0C1\uC810\uC5D0\uC11C \uBCC4\uBE5B \uC0AC\uD0D5 150\uAC1C\uB85C \uAD50\uD658\uD560
        \uC218 \uC788\uC5B4\uC694."
