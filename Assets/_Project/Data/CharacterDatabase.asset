    origin: "\uC678\uD22C\uC5D0\uC11C \uB5A8\uC5B4\uC9C4 \uB2E8\uCD94"
    personality: "\uC678\uD22C\uC5D0\uC11C \uB5A8\uC5B4\uC838 \uB098\uC628 \uADF8\uB0A0\uC758
      \uC790\uB9AC\uB97C \uC78A\uC9C0 \uBABB\uD574\uC11C, \uBB34\uC5C7\uC774\uB4E0
      \uD55C\uBC88 \uBD99\uC7A1\uC73C\uBA74 \uB193\uC9C0 \uC54A\uC544\uC694. \uCE5C\uAD6C\uC758
      \uC637\uC790\uB77D\uB3C4, \uBB38\uACE0\uB9AC\uB3C4, \uC9C0\uB098\uAC00\uB358
      \uBC14\uB78C\uB3C4 \uB124 \uAC1C\uC758 \uAD6C\uBA4D\uC5D0 \uC2E4\uC744 \uAC78\uC5B4
      \uAF2D \uBD99\uB4E4\uC9C0\uC694.\n\uB2E4\uC2DC\uB294 \uC544\uBB34\uAC83\uB3C4
      \uC783\uACE0 \uC2F6\uC9C0 \uC54A\uC740 \uC791\uC740 \uB2E8\uCD94\uC758 \uACE0\uC9D1\uC740,
      \uC218\uC120\uC810 \uC55E\uC5D0\uC11C \uB204\uAD6C\uBCF4\uB2E4 \uB4E0\uB4E0\uD55C
      \uBC84\uD300\uC774 \uB418\uC5B4 \uC918\uC694."
