    - id: jjak_postman
      name: "\uC591\uB9D0 \uC6B0\uD3B8\uBC30\uB2EC\uBD80"
      parentFormId: jjak_base
      tier: 1
      style: 4
      recommendedRole: 1
      description: "\uC591\uB9D0 \uC18D \uAE4A\uC740 \uC8FC\uBA38\uB2C8\uAC00 \uADF8\uB300\uB85C
        \uC6B0\uD3B8 \uAC00\uBC29\uC774 \uB418\uC5C8\uC5B4\uC694. \uC9DD\uC744 \uAE30\uB2E4\uB9AC\uB358
        \uB0A0\uB4E4\uC5D0 \uBD80\uCE58\uC9C0 \uBABB\uD55C \uD3B8\uC9C0\uB97C \uBAA8\uC544,
        \uC774\uC81C\uB294 \uB2E4\uB978 \uCE5C\uAD6C\uB4E4\uC758 \uB9C8\uC74C\uC744
        \uB300\uC2E0 \uC804\uD558\uB7EC \uB2E4\uB140\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uC218\uC120\uC810\uC5D0 \uB530\uB73B\uD55C \uC18C\uC2DD\uC744
        \uBC30\uB2EC\uD574 \uB0B4\uAD6C\uB3C4\uB97C \uCC44\uC6B0\uACE0, \uACC1\uC758
        \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uD798\uC744 \uC2E4\uC5B4 \uC918\uC694."
      portrait: {fileID: 21300000, guid: 4c00df44d34b1144a9cc9f33f303d29c, type: 3}
      skill:
        id: skill_jjak_postman
        name: "\uB9C8\uC74C \uBC30\uB2EC"
        description: "\uBE5B\uC73C\uB85C \uD480\uB824 \uB3CC\uC544\uAC00\uB294 \uAE38\uC5D0\uB3C4
          \uBC30\uB2EC\uC740 \uC78A\uC9C0 \uC54A\uC544\uC694. \uC591\uB9D0 \uC8FC\uBA38\uB2C8
          \uC18D \uD3B8\uC9C0\uAC00 \uC218\uC120\uC810\uC5D0 \uB2FF\uC73C\uBA74 \uBAA8\uB450\uC758
          \uB9C8\uC74C\uC774 \uB530\uB73B\uD574\uC838\uC694.\n\uBE5B\uC73C\uB85C
          \uD480\uB824 \uC0AC\uB77C\uC9C8 \uB54C \uC794\uD5A5\uC744 6 \uCC44\uC6B0\uACE0,
          \uBD88\uBE5B \uAC8C\uC774\uC9C0\uB97C 8% \uCC44\uC6CC\uC694."
