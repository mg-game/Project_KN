    - id: lala_waltz
      name: "\uC648\uCE20 \uC5D8\uB9AC\uC81C"
      parentFormId: lala_base
      tier: 1
      style: 4
      recommendedRole: 1
      description: "\uBA48\uCD98 \uC904 \uC54C\uC558\uB358 \uD0DC\uC5FD\uC774 \uB2E4\uC2DC
        \uAC10\uAE30\uACE0, \uC5D8\uB9AC\uC81C\uB294 \uD68C\uC804\uD310 \uC704\uC5D0\uC11C
        \uC648\uCE20\uB97C \uCD94\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694. \uD55C \uBC14\uD034
        \uB3CC \uB54C\uB9C8\uB2E4 \uC74C\uD45C\uAC00 \uB9AC\uBCF8\uCC98\uB7FC \uD480\uB824
        \uB098\uC640\uC694.\n\uC794\uD5A5\uC774\uB85C \uC18C\uD658\uB418\uBA74 \uC801\uB4E4\uC744
        \uC648\uCE20 \uC18D\uC73C\uB85C \uB04C\uC5B4\uBAA8\uC544, \uCE5C\uAD6C\uB4E4\uC774
        \uD55C\uAEBC\uBC88\uC5D0 \uACF5\uACA9\uD560 \uBB34\uB300\uB97C \uB9CC\uB4E4\uC5B4
        \uC918\uC694."
