    forms:
    - id: udu_base
      name: "\uB808\uC774\uB2C8"
      parentFormId: 
      tier: 0
      style: 0
      recommendedRole: 0
      description: "\uC6B0\uC0B0\uC0B4\uC774 \uAC08\uBE44\uBF08\uAC00 \uB418\uACE0,
        \uD3BC\uCE5C \uC6B0\uC0B0\uCC9C\uC774 \uB113\uC740 \uC5B4\uAE68\uC640 \uB9DD\uD1A0\uAC00
        \uB418\uC5C8\uC73C\uBA70, \uAD6C\uBD80\uB7EC\uC9C4 \uC190\uC7A1\uC774\uB294
        \uC9C0\uD321\uC774 \uAC19\uC740 \uAF2C\uB9AC\uB85C \uB0A8\uC558\uC5B4\uC694.
        \uBE44 \uC624\uB294 \uB0A0\uC5D0\uB9CC \uC4F8\uBAA8 \uC788\uB2E4\uACE0 \uBBFF\uC5B4\uC11C
        \uB298 \uACE0\uAC1C\uB97C \uD479 \uC219\uC774\uACE0 \uC788\uC9C0\uC694.\n\uADF8\uB798\uB3C4
        \uC9C0\uD0B4\uC774\uB85C \uC11C\uBA74 \uC6B0\uC0B0\uC744 \uD65C\uC9DD \uD3B4
        \uBC29\uC704\uB97C \uB36E\uACE0, \uBE57\uBB3C\uC5D0 \uC816\uC740 \uB4EF \uC801\uC758
        \uBC1C\uAC78\uC74C\uC744 \uBB34\uAC81\uAC8C \uB9CC\uB4E4\uC5B4\uC694."
      portrait: {fileID: 21300000, guid: 96499a679b60d7948841fbc451fac8b5, type: 3}
      skill:
        id: skill_udu_base
        name: "\uC6B0\uC0B0 \uD3BC\uCE58\uAE30"
        description: "\uC811\uC5B4 \uB450\uC5C8\uB358 \uC6B0\uC0B0\uC0B4\uC744 \uD65C\uC9DD
          \uD3B4 \uC218\uC120\uC810\uC744 \uB36E\uC5B4\uC694. \uBE44 \uC624\uB294
          \uB0A0\uC5D0\uB9CC \uC4F8\uBAA8 \uC788\uB2E4\uACE0 \uBBFF\uC9C0\uB9CC,
          \uC6B0\uC0B0 \uC544\uB798\uB294 \uC5B8\uC81C\uB098 \uD3EC\uADFC\uD574\uC694.
          \uBE44 \uC624\uB294 \uBC24\uC5D0\uB294 \uBE44 \uD2B9\uC131 \uC2DC\uB108\uC9C0\uB85C
          \uB354 \uB2E8\uB2E8\uD574\uC838\uC694.\n14\uCD08\uB9C8\uB2E4 \uC218\uC120\uC810\uC5D0
          \uACF5\uACA9\uB825 350%\uB9CC\uD07C \uD53C\uD574\uB97C \uB9C9\uB294 \uBCF4\uD638\uB9C9\uC744
          10\uCD08 \uB3D9\uC548 \uC50C\uC6CC\uC694."
        castText: "\uBE44\uAC00 \uC640\uB3C4 \uAD1C\uCC2E\uC544."
