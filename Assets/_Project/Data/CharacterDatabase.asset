    - id: jjak_rider
      name: "\uC591\uB9D0 \uAE30\uC218"
      parentFormId: jjak_marcher
      tier: 2
      style: 1
      recommendedRole: 1
      description: "\uD589\uC9C4\uD558\uB358 \uBC1C\uC774 \uC9C0\uCE60 \uBB34\uB835,
        \uC9DD\uC9DD\uC774\uB294 \uD138\uC2E4\uB85C \uC5EE\uC740 \uBAA9\uB9C8 \uC591\uB9D0\uC5D0
        \uC62C\uB77C\uD0D4\uC5B4\uC694. \uBAA9\uB9C8\uC758 \uAC08\uAE30\uB294 \uD480\uB9B0
        \uC62C\uC774\uACE0, \uACE0\uC090\uB294 \uB04A\uC5B4\uC9C4 \uC591\uB9D0\uBAA9\uC774\uC5D0\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uB204\uAD6C\uBCF4\uB2E4 \uBE60\uB974\uAC8C \uC804\uC7A5\uC744
        \uAC00\uB85C\uC9C8\uB7EC, \uAC00\uC7A5 \uC704\uD5D8\uD55C \uC801\uC5D0\uAC8C
        \uB3CC\uACA9\uD574 \uD070 \uD53C\uD574\uB97C \uC918\uC694."
      portrait: {fileID: 21300000, guid: 6f4ecd7032d04ab418747e40f690c253, type: 3}
      skill:
        id: skill_jjak_rider
        name: "\uBAA9\uB9C8 \uB3CC\uACA9"
        description: "\uD589\uC9C4\uD558\uB358 \uBC1C\uC774 \uD138\uC2E4 \uBAA9\uB9C8\uC5D0
          \uC62C\uB77C\uD0D4\uC5B4\uC694. \uC18C\uD658\uB418\uC790\uB9C8\uC790 \uD480\uB9B0
          \uC62C \uAC08\uAE30\uB97C \uD718\uB0A0\uB9AC\uBA70 \uAC00\uC7A5 \uC704\uD5D8\uD55C
          \uC801\uC5D0\uAC8C \uACE7\uC7A5 \uB3CC\uC9C4\uD574\uC694.\n\uC794\uD5A5\uC774\uB85C
          \uC18C\uD658\uB418\uBA74 \uAC00\uC7A5 \uAC15\uD55C \uC801(\uBCF4\uC2A4
          \uC6B0\uC120)\uC5D0\uAC8C \uACF5\uACA9\uB825 600% \uD53C\uD574\uB97C \uC8FC\uACE0,
          1\uCD08 \uB3D9\uC548 \uAE30\uC808\uC2DC\uCF1C\uC694."
        castText: "\uC774\uB7B4, \uB2EC\uB824\uB77C!"
        trigger: 2
        cooldown: 0
        initialDelay: 0
        target: 5
        radius: 0.6
        effects:
