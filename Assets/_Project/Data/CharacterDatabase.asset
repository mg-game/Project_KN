    - id: jjak_sniper
      name: "\uC591\uB9D0 \uC800\uACA9\uC218"
      parentFormId: jjak_acrobat
      tier: 2
      style: 3
      recommendedRole: 0
      description: "\uACE1\uC608\uC0AC \uC2DC\uC808\uC758 \uADE0\uD615 \uAC10\uAC01\uC73C\uB85C,
        \uB192\uC740 \uBE68\uB7AB\uC904 \uC704\uC5D0 \uAF3C\uC9DD \uC54A\uACE0 \uC11C
        \uC788\uB294 \uC9DD\uC9DD\uC774\uC608\uC694. \uD55C\uCABD \uB2E8\uCD94 \uB208\uC744
        \uC190\uC73C\uB85C \uAC00\uB9AC\uACE0, \uBC14\uB298\uB540 \uB208 \uD558\uB098\uB85C
        \uC544\uC8FC \uBA3C \uACF3\uAE4C\uC9C0 \uACA8\uB220\uC694.\n\uC9C0\uD0B4\uC774\uB85C
        \uC11C\uBA74 \uD33D\uD33D\uD558\uAC8C \uB2F9\uAE34 \uC591\uB9D0\uBAA9\uC744
        \uC0C8\uCD1D\uCC98\uB7FC \uD295\uACA8, \uBA40\uB9AC \uC788\uB294 \uC801 \uD558\uB098\uB97C
        \uC815\uD655\uD788 \uAFF0\uB6AB\uC5B4\uC694."
      portrait: {fileID: 21300000, guid: 3a10951159433924ab20adb40f7c5a61, type: 3}
      skill:
        id: skill_jjak_sniper
        name: "\uBC14\uB298\uB540 \uAD00\uD1B5"
        description: "\uBE68\uB7AB\uC904 \uC704\uC5D0\uC11C \uBC14\uB298\uB540 \uB208
          \uD558\uB098\uB85C \uACA8\uB208 \uB4A4, \uD33D\uD33D\uD558\uAC8C \uB2F9\uAE34
          \uC591\uB9D0\uBAA9 \uC0C8\uCD1D\uC73C\uB85C \uC740\uBC14\uB298\uC744 \uC3D8\uC544\uC694.
          \uC2E4\uC744 \uB04C\uACE0 \uB0A0\uC544\uAC04 \uBC14\uB298\uC774 \uD55C
          \uC904\uB85C \uB298\uC5B4\uC120 \uC801\uC744 \uBAA8\uB450 \uAFF0\uC5B4\uC694.\n10\uCD08\uB9C8\uB2E4
          \uC790\uAE30 \uBC29\uD5A5(\uB808\uC778)\uC758 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C
          \uACF5\uACA9\uB825 450% \uD53C\uD574\uB97C \uC918\uC694."
        castText: "\uD55C \uB540\uC5D0 \uAFF0\uB6AB\uC5B4!"
        trigger: 1
        cooldown: 10
        initialDelay: 4
        target: 13
        radius: 0.6
