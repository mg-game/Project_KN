    baseFormId: lala_base
    forms:
    - id: lala_base
      name: "\uC5D8\uB9AC\uC81C"
      parentFormId: 
      tier: 0
      style: 5
      recommendedRole: 0
      description: "\uC624\uB974\uACE8\uC758 \uD68C\uC804\uD310\uC774 \uCE58\uB9DB\uC790\uB77D\uCC98\uB7FC
        \uBE59\uAE00 \uB3C4\uB294 \uD558\uCCB4\uAC00 \uB418\uACE0, \uB4F1\uC758 \uD0DC\uC5FD
        \uC5F4\uC1E0\uB294 \uC2EC\uC7A5\uCC98\uB7FC \uB611\uB531\uC774\uBA70 \uAC10\uACA8\uC694.
        \uBE57\uC0B4 \uAC19\uC740 \uC74C\uD310\uACFC \uC791\uC740 \uD540\uB4E4\uC774
        \uB178\uB798\uD558\uB294 \uBAA9\uC18C\uB9AC\uC608\uC694.\n\uC9C0\uD0B4\uC774\uB85C
        \uC11C\uBA74 \uB05D\uB098\uC9C0 \uC54A\uB294 \uC790\uC7A5\uAC00\uB85C \uC218\uC120\uC810\uC758
        \uC0C1\uCC98\uB97C \uC5B4\uB8E8\uB9CC\uC838, \uC2A4\uB974\uB974 \uC544\uBB3C\uAC8C
        \uD574\uC694."
      portrait: {fileID: 21300000, guid: 9c319423b42dc8e428e458077c89d17c, type: 3}
      skill:
        id: skill_lala_base
        name: "\uC790\uC7A5\uAC00"
        description: "\uD0DC\uC5FD\uC744 \uAC10\uC73C\uBA74 \uB05D\uB098\uC9C0 \uC54A\uB294
          \uC790\uC7A5\uAC00\uAC00 \uD758\uB7EC\uB098\uC640\uC694. \uB178\uB798\uAC00
          \uB2FF\uB294 \uACF3\uB9C8\uB2E4 \uC218\uC120\uC810\uC758 \uC0C1\uCC98\uAC00
          \uC2A4\uB974\uB974 \uC544\uBB3C\uC5B4\uC694.\n15\uCD08\uB9C8\uB2E4 \uC218\uC120\uC810
          \uB0B4\uAD6C\uB3C4\uB97C \uACF5\uACA9\uB825 300%\uB9CC\uD07C \uD68C\uBCF5\uD558\uACE0,
          6\uCD08 \uB3D9\uC548 \uCD08\uB2F9 \uACF5\uACA9\uB825 60%\uC529 \uD68C\uBCF5\uD574\uC694."
