      description: "\uCD09\uCD09\uD558\uAC8C \uB179\uC544 \uAE00\uB85C\uC2A4\uAC00
        \uB41C \uB8E8\uB8E8\uD31D\uC774\uC5D0\uC694. \uBC18\uC9DD\uC774\uB294 \uBAB8\uC5D0\uC11C
        \uB048\uC801\uD55C \uAD11\uD0DD\uC774 \uB69D\uB69D \uD758\uB7EC\uB0B4\uB824\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uBBF8\uB044\uB7EC\uC9C0\uB4EF \uB2E4\uAC00\uAC00
        \uB048\uC801\uD55C \uAD11\uD0DD\uC744 \uCE60\uD574, \uC801\uC758 \uBC1C\uC744
        \uBC14\uB2E5\uC5D0 \uAF2D \uBD99\uC5EC \uB46C\uC694."
      portrait: {fileID: 21300000, guid: 090826545422afa438b0adffc3b240e6, type: 3}
      skill:
        id: skill_rouge_gloss
        name: "\uAD11\uD0DD \uBC18\uC0AC"
        description: "\uCD09\uCD09\uD55C \uAD11\uD0DD\uC774 \uBE5B\uC744 \uD295\uACA8
          \uB0B4\uC694. \uC801\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uBC18\uC0AC\uB41C
          \uBE5B\uC774 \uC801 \uC0AC\uC774\uB97C \uD280\uC5B4 \uB2E4\uB2C8\uACE0,
          \uD758\uB7EC\uB0B4\uB9B0 \uAE00\uB85C\uC2A4\uC5D0 \uBC1C\uC774 \uB048\uC801\uD558\uAC8C
          \uBD99\uC5B4\uC694.\n\uC801\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74(2\uCD08\uC5D0
          \uD55C \uBC88\uAE4C\uC9C0) \uC801 \uC0AC\uC774\uB97C 4\uBC88 \uD280\uB294
          \uACF5\uACA9\uB825 130% \uC5F0\uC1C4 \uD53C\uD574\uB97C \uC8FC\uACE0, \uACF5\uACA9
          \uB300\uC0C1 \uC8FC\uBCC0\uC758 \uC801\uC744 3\uCD08 \uB3D9\uC548 45% \uB290\uB9AC\uAC8C
          \uB9CC\uB4E4\uC5B4\uC694."
        castText: "\uBC18\uC9DD, \uBBF8\uB044\uB7EC\uC838!"
        trigger: 4
        cooldown: 2
        initialDelay: 0
        target: 4
        radius: 0.6
        effects:
