  - id: mongdang
    name: "\uBABD\uC2E4"
    species: "\uCD1B\uBD88\uC871"
    origin: "\uB2E4 \uD0C0\uBC84\uB9B0 \uBABD\uB2F9\uCD08"
    personality: "\uB179\uC744\uC218\uB85D \uBAB8\uC774 \uC791\uC544\uC9C0\uB294
      \uAC78 \uC54C\uBA74\uC11C\uB3C4, \uB05D\uAE4C\uC9C0 \uC8FC\uBCC0\uC744 \uBC1D\uD788\uB294
      \uBABD\uB2F9\uCD08\uC608\uC694. \uCD1B\uB18D\uC774 \uB69D\uB69D \uD758\uB7EC
      \uD0A4\uAC00 \uD55C \uBF18\uC529 \uC904\uC5B4\uB3C4 \"\uAD1C\uCC2E\uC544, \uC544\uC9C1
      \uC2EC\uC9C0\uAC00 \uB0A8\uC558\uB294\uAC78\" \uD558\uACE0 \uC6C3\uC5B4\uC694.\n\uAC81\uC774
      \uB9CE\uC544 \uBC14\uB78C \uC18C\uB9AC\uC5D0\uB3C4 \uBD88\uAF43\uC774 \uC6C0\uCE20\uB7EC\uB4E4\uC9C0\uB9CC,
      \uC5B4\uB450\uC6B4 \uACF3\uC5D0 \uCE5C\uAD6C\uAC00 \uC788\uC73C\uBA74 \uAC00\uC7A5
      \uBA3C\uC800 \uBD88\uAF43\uC744 \uD0A4\uC6B0\uB294 \uC791\uACE0 \uB2E4\uC815\uD55C
      \uC6A9\uAE30\uB97C \uAC00\uC84C\uC5B4\uC694."
    grade: 1
    bodyType: 0
    traits: 0200000004000000
    mainColor: {r: 1, g: 0.94509804, b: 0.8392157, a: 1}
    subColor: {r: 0.9137255, g: 0.6509804, b: 0.7764706, a: 1}
    accentColor: {r: 1, g: 0.72156864, b: 0.41960785, a: 1}
    neutralColor: {r: 0.41960785, g: 0.3529412, b: 0.5568628, a: 1}
    baseFormId: mong_base
    forms:
    - id: mong_base
      name: "\uBABD\uC2E4"
      parentFormId: 
      tier: 0
      style: 5
      recommendedRole: 1
      description: "\uB2E4 \uD0C0 \uBC84\uB9B0 \uBABD\uB2F9\uCD08\uC608\uC694. \uB179\uC544\uB0B4\uB9B0
        \uCD1B\uB18D\uC774 \uB3D9\uAE00\uB3D9\uAE00\uD55C \uBAB8\uC774 \uB418\uACE0,
        \uC2EC\uC9C0 \uB05D\uC758 \uC791\uC740 \uBD88\uAF43\uC740 \uAE30\uBD84\uC5D0
        \uB530\uB77C \uCEE4\uC84C\uB2E4 \uC791\uC544\uC9C0\uB294 \uB354\uB4EC\uC774\uAC00
        \uB418\uC5C8\uC5B4\uC694.\n\uC794\uD5A5\uC774\uB85C \uC18C\uD658\uB418\uBA74
        \uB179\uC544\uB0B4\uB9B0 \uCD1B\uB18D\uC73C\uB85C \uC218\uC120\uC810\uC758
        \uC0C1\uCC98\uB97C \uB530\uC2A4\uD558\uAC8C \uBA54\uC6CC \uC8FC\uACE0, \uB179\uC544
        \uB098\uC628 \uBD88\uBE5B\uC744 \uBAA8\uC544 \uC218\uC120\uC810\uC758 \uB4F1\uBD88\uC744
        \uCC44\uC6CC\uC694."
      portrait: {fileID: 21300000, guid: 517e8e652e62c9a4b92f9e2a7827bafd, type: 3}
      skill:
        id: skill_mong_base
        name: "\uB179\uC544\uB4DC\uB294 \uBE5B"
        description: "\uB179\uC744\uC218\uB85D \uBAB8\uC740 \uC791\uC544\uC9C0\uC9C0\uB9CC,
          \uD758\uB7EC\uB0B4\uB9B0 \uCD1B\uB18D\uC740 \uC218\uC120\uC810\uC758 \uAC08\uB77C\uC9C4
          \uD2C8\uC744 \uB530\uB73B\uD558\uAC8C \uBA54\uC6CC\uC694. \uB179\uC544
          \uB098\uC628 \uBD88\uBE5B\uB3C4 \uBC84\uB9AC\uC9C0 \uC54A\uACE0 \uC218\uC120\uC810
          \uB4F1\uBD88\uC5D0 \uD55C \uBC29\uC6B8\uC529 \uBAA8\uC544 \uB46C\uC694.\n8\uCD08\uB9C8\uB2E4
          \uC218\uC120\uC810 \uB0B4\uAD6C\uB3C4\uB97C \uACF5\uACA9\uB825 200%\uB9CC\uD07C
          \uD68C\uBCF5\uD558\uACE0, \uBD88\uBE5B \uAC8C\uC774\uC9C0\uB97C 3% \uCC44\uC6CC\uC694."
        castText: "\uC544\uC9C1 \uC2EC\uC9C0\uAC00 \uB0A8\uC558\uB294\uAC78!"
        trigger: 1
        cooldown: 8
        initialDelay: 2
        target: 1
        radius: 0.6
        effects:
        - type: 1
          value: 2
          duration: 0
          count: 0
        - type: 12
