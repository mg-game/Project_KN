    - id: jjak_signal
      name: "\uC591\uB9D0 \uC2E0\uD638\uC218"
      parentFormId: jjak_caravan
      tier: 2
      style: 4
      recommendedRole: 0
      description: "\uCE74\uB77C\uBC18 \uB9E8 \uAF2D\uB300\uAE30 \uAE43\uB300\uC5D0
        \uC62C\uB77C\uC120 \uC9DD\uC9DD\uC774\uC608\uC694. \uC591\uCABD \uBC1C\uBAA9\uC5D0
        \uAC10\uC740 \uC0C9\uC2E4 \uAE43\uBC1C\uC744 \uD754\uB4E4\uC5B4, \uD769\uC5B4\uC9C4
        \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \"\uC774\uCABD\uC774\uC57C!\" \uD558\uACE0
        \uAE38\uC744 \uC54C\uB824\uC694.\n\uC9C0\uD0B4\uC774\uB85C \uC11C\uBA74 \uAE43\uBC1C
        \uC2E0\uD638\uB85C \uBAA8\uB450\uC758 \uACF5\uACA9 \uBC15\uC790\uB97C \uB9DE\uCD94\uACE0,
        \uC218\uC120\uC810\uC758 \uBD88\uBE5B\uC774 \uAEBC\uC9C0\uC9C0 \uC54A\uB3C4\uB85D
        \uC9C0\uCF1C \uB0B4\uC694."
      portrait: {fileID: 21300000, guid: 1b089d0fbccb0c94aa8cc1b4503a75d1, type: 3}
      skill:
        id: skill_jjak_signal
        name: "\uBD88\uBE5B \uC2E0\uD638"
        description: "\uC218\uC120\uC810\uC5D0 \uBD88\uC774 \uBC1D\uD600\uC9C0\uBA74
          \uCE74\uB77C\uBC18 \uAF2D\uB300\uAE30\uC5D0\uC11C \uC0C9\uC2E4 \uAE43\uBC1C\uC744
          \uD798\uAECF \uD754\uB4E4\uC5B4\uC694. \uAE43\uBC1C \uC2E0\uD638\uB97C
          \uBCF8 \uC9C0\uD0B4\uC774\uB4E4\uC740 \uBC15\uC790\uB97C \uB9DE\uCDB0 \uB354
          \uBE60\uB974\uAC8C \uACF5\uACA9\uD574\uC694.\n\uC218\uC120\uC810\uC5D0
          \uBD88\uC744 \uBC1D\uD788\uBA74 \uBAA8\uB4E0 \uC9C0\uD0B4\uC774\uC758 \uACF5\uACA9
          \uC18D\uB3C4\uB97C 10\uCD08 \uB3D9\uC548 35% \uC62C\uB824\uC694."
        castText: "\uC774\uCABD\uC774\uC57C, \uB2E4 \uAC19\uC774!"
        trigger: 5
        cooldown: 0
        initialDelay: 0
        target: 11
        radius: 0.6
        effects:
        - type: 9
          value: 35
          duration: 10
          count: 0
        vfx: vfx_buff_crown
      attack: 19.2
