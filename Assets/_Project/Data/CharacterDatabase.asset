    personality: "\uB9DE\uB294 \uC790\uBB3C\uC1E0\uB97C \uC783\uC5B4\uBC84\uB9B0
      \uC5F4\uC1E0\uB77C, \uB208\uC5D0 \uB744\uB294 \uBB38\uB9C8\uB2E4 \uB611\uB611
      \uB450\uB4DC\uB9AC\uACE0 \uC5F4\uC1E0 \uAD6C\uBA4D\uB9C8\uB2E4 \uBAB8\uC744
      \uB9DE\uCDB0 \uBD10\uC694. \uBC31 \uBC88\uC744 \uD2C0\uB824\uB3C4 \"\uC774\uBC88\uC5D4
      \uC5F4\uB9B4\uC9C0\uB3C4 \uBAB0\uB77C!\" \uD558\uBA70 \uD648 \uD30C\uC778 \uAF2C\uB9AC\uB97C
      \uD754\uB4E4\uC9C0\uC694.\n\uADF8 \uB048\uC9C8\uAE34 \uD638\uAE30\uC2EC \uB355\uBD84\uC5D0,
      \uB0A8\uB4E4\uC774 \uC9C0\uB098\uCE5C \uC791\uC740 \uD2C8\uACFC \uC228\uC740
      \uC57D\uC810\uC744 \uB204\uAD6C\uBCF4\uB2E4 \uBA3C\uC800 \uCC3E\uC544\uB0B4\uC694."
