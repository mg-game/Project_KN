      description: "\uC218\uB9CE\uC740 \uBB38\uC744 \uB450\uB4DC\uB9B0 \uB05D\uC5D0,
        \uD0A4\uD0A4\uC758 \uD648\uC740 \uC5B4\uB5A4 \uC790\uBB3C\uC1E0\uC5D0\uB3C4
        \uC870\uAE08\uC529 \uB9DE\uB294 \uBAA8\uC591\uC73C\uB85C \uB2F3\uC558\uC5B4\uC694.
        \uC5B4\uB5A4 \uBB38\uC774\uB4E0 \uC5F4 \uC218 \uC788\uC73C\uB2C8, \uC228\uC740
        \uAC83\uB4E4\uB3C4 \uB354\uB294 \uC228\uC744 \uC218 \uC5C6\uC9C0\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uC228\uC5B4 \uC788\uB358 \uC801\uC758 \uBB38\uC744
        \uD65C\uC9DD \uC5F4\uC5B4 \uB4DC\uB7EC\uB0B4\uACE0, \uC5F4\uC1E0 \uBE5B\uC744
        \uC801\uC5D0\uAC8C\uC11C \uC801\uC73C\uB85C \uD295\uACA8 \uCE5C\uAD6C\uB4E4\uC758
        \uAE38\uC744 \uC5F4\uC5B4 \uC918\uC694."
      portrait: {fileID: 21300000, guid: f5d2544e6bf33cc49a499748e8b315d1, type: 3}
      skill:
        id: skill_chal_master
        name: "\uBAA8\uB4E0 \uBB38 \uC5F4\uAE30"
        description: "\uB2F3\uACE0 \uB2F3\uC544 \uC5B4\uB5A4 \uC790\uBB3C\uC1E0\uC5D0\uB3C4
          \uB9DE\uAC8C \uB41C \uD648\uC73C\uB85C, \uC228\uC740 \uBB38\uAE4C\uC9C0
          \uBAA8\uB450 \uC5F4\uC5B4\uC816\uD600\uC694. \uC5F4\uB9B0 \uBB38\uD2C8\uC73C\uB85C
          \uD284 \uC5F4\uC1E0 \uBE5B\uC774 \uC801\uC5D0\uAC8C\uC11C \uC801\uC73C\uB85C
          \uC62E\uACA8 \uB2E4\uB140\uC694.\n9\uCD08\uB9C8\uB2E4 \uC228\uC5B4 \uC788\uB294
          \uC801\uC744 6\uCD08 \uB3D9\uC548 \uB4DC\uB7EC\uB0B4\uACE0, \uC801 \uC0AC\uC774\uB97C
          4\uBC88 \uD280\uB294 \uACF5\uACA9\uB825 150% \uC5F0\uC1C4 \uD53C\uD574\uB97C
          \uC918\uC694."
        castText: "\uC5B4\uB5A4 \uBB38\uC774\uB4E0 \uC5F4\uC5B4 \uC904\uAC8C!"
        trigger: 1
        cooldown: 9
        initialDelay: 2
        target: 3
        radius: 1
        effects:
        - type: 13
          value: 0
          duration: 6
          count: 0
        - type: 16
          value: 1.5
          duration: 0
