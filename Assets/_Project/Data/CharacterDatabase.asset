    - id: jjak_marcher
      name: "\uC591\uB9D0 \uD589\uC9C4\uBCD1"
      parentFormId: jjak_base
      tier: 1
      style: 1
      recommendedRole: 1
      description: "\uBAA9\uC774 \uAE34 \uC591\uB9D0\uC744 \uB05D\uAE4C\uC9C0 \uB2F9\uACA8
        \uC2E0\uACE0, \uCEE4\uD504\uB97C \uD589\uC9C4 \uBAA8\uC790\uCC98\uB7FC \uB192\uC774
        \uC138\uC6B4 \uC9DD\uC9DD\uC774\uC608\uC694. \uB4A4\uAFC8\uCE58\uB97C \uB9DE\uBD80\uB52A\uCE58\uB294
        \uBC1C\uC18C\uB9AC\uAC00 \uBD81\uC18C\uB9AC\uAC00 \uB418\uACE0, \uB3CC\uB3CC
        \uB9CC \uC591\uB9D0\uBAA9\uC740 \uC9E7\uC740 \uC9C0\uD718\uBD09\uC774 \uB418\uC5C8\uC5B4\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uC704\uD5D8\uD55C \uBC29\uD5A5\uC73C\uB85C \uAC00\uC7A5
        \uBA3C\uC800 \uB6F0\uC5B4\uB098\uAC00, \uAC00\uAE4C\uC774 \uBD99\uC740 \uC801\uC744
        \uD798\uAECF \uB4E4\uC774\uBC1B\uC544\uC694."
      portrait: {fileID: 21300000, guid: 5ed9e94a8aeb6c845a21c758d1342265, type: 3}
      skill:
        id: skill_jjak_marcher
        name: "\uCFF5\uCFF5 \uD589\uC9C4"
        description: "\uC801\uC744 \uD558\uB098 \uC4F0\uB7EC\uB728\uB9B4 \uB54C\uB9C8\uB2E4
          \uB4A4\uAFC8\uCE58\uB97C \uB9DE\uBD80\uB52A\uCE58\uBA70 \uB354 \uD798\uCC28\uAC8C
          \uBC1C\uC744 \uAD74\uB7EC\uC694. \uD589\uC9C4\uC774 \uC774\uC5B4\uC9C8\uC218\uB85D
          \uBA3C\uC9C0\uAC00 \uD480\uC369\uD480\uC369 \uC77C\uC5B4\uB098\uC694.\n\uC801\uC744
          \uC4F0\uB7EC\uB728\uB9AC\uBA74(2.5\uCD08\uC5D0 \uD55C \uBC88\uAE4C\uC9C0)
          \uC8FC\uBCC0\uC758 \uC801\uC5D0\uAC8C \uACF5\uACA9\uB825 160% \uD53C\uD574\uB97C
          \uC8FC\uACE0, \uC0B4\uC9DD \uBC00\uC5B4\uB0B4\uC694."
        castText: "\uD558\uB098, \uB458! \uCFF5!"
        trigger: 4
        cooldown: 2.5
        initialDelay: 0
        target: 3
        radius: 0.45
        effects:
        - type: 0
          value: 1.6
          duration: 0
          count: 0
        - type: 5
          value: 0.15
          duration: 0
          count: 0
        vfx: vfx_dust_poof
