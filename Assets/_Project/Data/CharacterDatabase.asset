  - id: lalabell
    name: "\uC5D8\uB9AC\uC81C"
    species: "\uC624\uB974\uACE8\uC871"
    origin: "\uB9C8\uC9C0\uB9C9 \uC74C\uC774 \uACE0\uC7A5 \uB09C \uC624\uB974\uACE8"
    personality: "\uB9C8\uC9C0\uB9C9 \uC74C\uC774 \uACE0\uC7A5 \uB09C \uC624\uB974\uACE8\uC774\uC5D0\uC694.
      \uD0DC\uC5FD\uC744 \uAC10\uC73C\uBA74 \uB204\uAD6C\uBCF4\uB2E4 \uC544\uB984\uB2E4\uC6B4
      \uC648\uCE20\uB97C \uC5F0\uC8FC\uD558\uC9C0\uB9CC, \uACE1\uC758 \uB05D\uC5D0
      \uB2E4\uB2E4\uB974\uBA74 \uC5B8\uC81C\uB098 \uBA48\uCE6B\uD558\uBA70 \uC228\uC744
      \uACE0\uB974\uC9C0\uC694. \uB9C8\uC9C0\uB9C9 \uC74C\uC744 \uC5F0\uC8FC\uD558\uBA74
      \uBAA8\uB4E0 \uAC83\uC774 \uB05D\uB098 \uBC84\uB9B4\uAE4C \uBD10 \uB450\uB835\uAC70\uB4E0\uC694.\n\uADF8\uB798\uC11C
      \uC5D8\uB9AC\uC81C\uC758 \uB178\uB798\uB294 \uB298 \uB05D\uB098\uC9C0 \uC54A\uC740
      \uCC44 \uB9F4\uB3CC\uC544\uC694. \uADF8 \uAE34 \uC5EC\uC6B4\uC774 \uCE5C\uAD6C\uB4E4\uC758
      \uB4F1\uC744 \uC624\uB798\uB3C4\uB85D \uB2E4\uC815\uD558\uAC8C \uBC00\uC5B4
      \uC900\uB2F5\uB2C8\uB2E4."
    grade: 4
    bodyType: 2
    traits: 0300000002000000
    mainColor: {r: 0.76862746, g: 0.69803923, b: 0.9490196, a: 1}
    subColor: {r: 0.9490196, g: 0.72156864, b: 0.8156863, a: 1}
    accentColor: {r: 0.9490196, g: 0.76862746, b: 0.41960785, a: 1}
