    - id: jjak_threadweb
      name: "\uC2E4\uD0C0\uB798 \uC5F0\uACB0\uB9DD \uC9DD\uC9DD\uC774"
      emotion: "\uAE38 \uC783\uC74C \u2192 \uC5F0\uACB0"
      description: "\uAE38\uC744 \uC783\uC740 \uCE5C\uAD6C\uB4E4\uC744 \uC787\uB294
        \uC2E4\uD0C0\uB798 \uC548\uB0B4\uC790\uC608\uC694.\n\uC9DD\uC9DD\uC774\uC758
        \uBAB8\uC774 \uD480\uB9B0 \uC2E4\uD0C0\uB798\uB85C \uB418\uB3CC\uC544\uAC00,
        \uB9C8\uBC95\uC73C\uB85C \uBE5B\uB098\uB294 \uC2E4\uC774 \uB418\uC5C8\uC5B4\uC694.
        \uBE5B\uB098\uB294 \uC2E4\uC740 \uBCC4\uC790\uB9AC\uCC98\uB7FC \uC774\uC5B4\uC838
        \uBCF4\uC774\uC9C0 \uC54A\uB294 \uAE38\uC744 \uBC1D\uD788\uACE0, \uCE5C\uAD6C\uB4E4\uC774
        \uC548\uC804\uD558\uAC8C \uB3C4\uCC29\uD560 \uC218 \uC788\uB3C4\uB85D \uAE38\uACFC
        \uC5F0\uACB0\uC744 \uB2E4\uC2DC \uC5EE\uC5B4 \uB0B4\uC694.\n\uC2E4\uC740
        \uC774\uC5B4\uC838\uB3C4, \uB9C8\uC74C\uC740 \uC790\uC720\uB86D\uAC8C. \uD568\uAED8\uB77C\uC11C
        \uAE38\uC744 \uCC3E\uC744 \uC218 \uC788\uC5B4\uC694."
      acquisition: "\uC9DD\uC9DD\uC774 \uACC4\uBCF4 \uACF5\uBA85 Lv.5 \uB2EC\uC131
        \uC2DC \uBC1B\uC744 \uC218 \uC788\uC5B4\uC694."
