  - id: udukeoni
    name: "\uB808\uC774\uB2C8"
    species: "\uC6B0\uC0B0\uC871"
    origin: "\uC8FC\uC778\uC744 \uAE30\uB2E4\uB9B0 \uC6B0\uC0B0"
    personality: "\uC8FC\uC778\uC744 \uAE30\uB2E4\uB9AC\uBA70 \uC6B0\uC0B0\uAF42\uC774\uC5D0\uC11C
      \uBA87 \uACC4\uC808\uC744 \uBCF4\uB0B8 \uC6B0\uC0B0\uC774\uC5D0\uC694. \uBE44\uAC00
      \uC624\uC9C0 \uC54A\uB294 \uB0A0\uC5D4 \uC790\uC2E0\uC774 \uC4F8\uBAA8\uC5C6\uB2E4\uACE0
      \uC0DD\uAC01\uD574, \uAD6C\uC11D\uC5D0 \uC6B0\uB450\uCEE4\uB2C8 \uC11C\uC11C
      \uD558\uB298\uB9CC \uC62C\uB824\uB2E4\uBCF4\uC9C0\uC694.\n\uD558\uC9C0\uB9CC
      \uD558\uB298\uC774 \uD750\uB824\uC9C0\uACE0 \uCCAB \uBE57\uBC29\uC6B8\uC774
      \uB5A8\uC5B4\uC9C0\uBA74, \uC811\uC5B4 \uB450\uC5C8\uB358 \uC0B4\uC744 \uD65C\uC9DD
      \uD3B4\uACE0 \uB204\uAD6C\uBCF4\uB2E4 \uBA3C\uC800 \uCE5C\uAD6C\uB4E4\uC758
      \uBA38\uB9AC \uC704\uB97C \uB36E\uC5B4\uC694. \uAE30\uB2E4\uB9BC\uC5D0 \uC775\uC219\uD55C
      \uB9CC\uD07C, \uD55C\uBC88 \uC9C0\uD0A4\uAE30\uB85C \uD55C \uC790\uB9AC\uB294
      \uC808\uB300 \uB5A0\uB098\uC9C0 \uC54A\uC544\uC694."
