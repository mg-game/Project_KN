    - id: chal_lock
      name: "\uC790\uBB3C\uC1E0 \uAE30\uC0AC"
      parentFormId: chal_base
      tier: 1
      style: 0
      recommendedRole: 0
      description: "\uB9DE\uB294 \uC790\uBB3C\uC1E0\uB97C \uB05D\uB0B4 \uCC3E\uC9C0
        \uBABB\uD55C \uD0A4\uD0A4\uB294, \uC2A4\uC2A4\uB85C \uC790\uBB3C\uC1E0\uAC00
        \uB418\uAE30\uB85C \uD588\uC5B4\uC694. \uBB35\uC9C1\uD55C \uC790\uBB3C\uD1B5\uC744
        \uAC11\uC637\uCC98\uB7FC \uB450\uB974\uACE0, \uB465\uADFC \uAC78\uC1E0\uB97C
        \uD22C\uAD6C\uCC98\uB7FC \uC37C\uC9C0\uC694.\n\uC9C0\uD0B4\uC774\uB85C \uC11C\uBA74
        \uBC29\uC704\uB97C \uCCA0\uCEE5 \uC7A0\uADF8\uB4EF \uB9C9\uC544\uC11C\uC11C,
        \uB4E4\uC5B4\uC624\uB294 \uC801\uC744 \uBB35\uC9C1\uD558\uAC8C \uB2A6\uCDB0\uC694."
      portrait: {fileID: 21300000, guid: 066891bac7b4b174c8071a3550d85312, type: 3}
      skill:
        id: skill_chal_lock
        name: "\uCD5C\uD6C4\uC758 \uBE57\uC7A5"
        description: "\uB9DE\uB294 \uC790\uBB3C\uC1E0\uB97C \uB05D\uB0B4 \uCC3E\uC9C0
          \uBABB\uD55C \uD0A4\uD0A4\uB294 \uC2A4\uC2A4\uB85C \uC790\uBB3C\uC1E0\uAC00
          \uB418\uC5C8\uC5B4\uC694. \uC218\uC120\uC810\uC774 \uC704\uD5D8\uD574\uC9C0\uBA74
          \uC628\uBAB8\uC758 \uAC78\uC1E0\uB97C \uD55C\uAEBC\uBC88\uC5D0 \uCCA0\uCEE5
          \uC7A0\uAC00 \uBC84\uB824\uC694.\n\uC218\uC120\uC810 \uB0B4\uAD6C\uB3C4\uAC00
          30% \uC544\uB798\uB85C \uB5A8\uC5B4\uC9C0\uBA74(\uC804\uD22C\uB9C8\uB2E4
          \uD55C \uBC88) \uBAA8\uB4E0 \uC801\uC744 2.5\uCD08 \uB3D9\uC548 \uAE30\uC808\uC2DC\uD0A4\uACE0,
          \uBA40\uB9AC \uBC00\uC5B4\uB0B4\uC694."
        castText: "\uC5EC\uAE30\uC11C\uBD80\uD130\uB294 \uBABB \uC9C0\uB098\uAC00!"
        trigger: 7
        cooldown: 0
