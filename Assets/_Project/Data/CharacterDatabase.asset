    - id: jjak_acrobat
      name: "\uC591\uB9D0 \uACE1\uC608\uC0AC"
      parentFormId: jjak_base
      tier: 1
      style: 2
      recommendedRole: 1
      description: "\uACE0\uBB34\uC904\uC774 \uB298\uC5B4\uB098 \uBC84\uB9B0 \uC591\uB9D0\uBAA9\uC744
        \uC6A9\uC218\uCCA0\uCC98\uB7FC \uC4F0\uB294 \uACE1\uC608\uC0AC\uC608\uC694.
        \uBC1C\uB05D\uC73C\uB85C \uACF5\uC911\uC81C\uBE44\uB97C \uB3CC\uB2E4\uAC00,
        \uCB49 \uB298\uC5B4\uB09C \uBAB8\uC744 \uACE0\uB9AC\uCC98\uB7FC \uB358\uC838
        \uBB34\uC5C7\uC774\uB4E0 \uD718\uAC10\uC544\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uC801 \uC0AC\uC774\uB97C \uD1B5\uD1B5 \uD280\uC5B4
        \uB2E4\uB2C8\uBA70 \uC7A0\uAE50\uC529 \uAF41\uAF41 \uBB36\uC5B4 \uB450\uC5B4,
        \uCE5C\uAD6C\uB4E4\uC774 \uACF5\uACA9\uD560 \uD2C8\uC744 \uB9CC\uB4E4\uC5B4\uC694."
      portrait: {fileID: 21300000, guid: 63fb40b628f6d1742bfa401649a8aac8, type: 3}
      skill:
        id: skill_jjak_acrobat
        name: "\uACE0\uBB34\uC904 \uC62C\uAC00\uBBF8"
        description: "\uB298\uC5B4\uB098 \uBC84\uB9B0 \uC591\uB9D0\uBAA9\uC744 \uACE0\uB9AC\uCC98\uB7FC
          \uD718\uD718 \uB3CC\uB824 \uB358\uC838\uC694. \uACF5\uC911\uC81C\uBE44
          \uD55C \uBC88\uC774\uBA74 \uD769\uC5B4\uC838 \uC788\uB358 \uC801\uB4E4\uC774
          \uD55C\uB370 \uC5C9\uCF1C \uAF3C\uC9DD \uBABB \uD574\uC694.\n8\uCD08\uB9C8\uB2E4
          \uACF5\uACA9 \uB300\uC0C1 \uC8FC\uBCC0\uC758 \uC801\uC744 \uD55C\uB370
          \uB04C\uC5B4\uB2F9\uAE30\uACE0, 1\uCD08 \uB3D9\uC548 \uAE30\uC808\uC2DC\uCF1C\uC694."
        castText: "\uD718\uB9AC\uB9AD, \uC7A1\uC558\uB2E4!"
        trigger: 1
        cooldown: 8
        initialDelay: 2
