    - id: mong_firefly
      name: "\uBC18\uB527\uBD88 \uBABD\uC2E4"
      parentFormId: mong_base
      tier: 1
      style: 1
      recommendedRole: 1
      description: "\uB179\uACE0 \uB610 \uB179\uC544 \uC190\uD1B1\uB9CC\uD07C \uC791\uC544\uC9C4
        \uBABD\uC2E4\uC740, \uBD88\uAF43 \uD558\uB098 \uB0A8\uC740 \uBAB8\uC73C\uB85C
        \uB0A0\uC544\uC624\uB974\uB294 \uBC95\uC744 \uBC30\uC6E0\uC5B4\uC694. \uCD1B\uB18D\uC73C\uB85C
        \uBE5A\uC740 \uC587\uC740 \uB0A0\uAC1C\uB97C \uB2EC\uACE0, \uBC18\uB527\uBD88\uCC98\uB7FC
        \uAE5C\uBE61\uC774\uBA70 \uC5B4\uB460 \uC18D\uC744 \uB204\uBCBC\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uC7AC\uBE60\uB974\uAC8C \uC801\uC5D0\uAC8C \uB0A0\uC544\uB4E4\uC5B4,
        \uB728\uAC70\uC6B4 \uBD88\uAF43\uC73C\uB85C \uB4E4\uC774\uBC1B\uC544\uC694."
      portrait: {fileID: 21300000, guid: 7510081e6dd3900498d02f420c6e330a, type: 3}
      skill:
        id: skill_mong_firefly
        name: "\uBC18\uB527\uBD88 \uB5BC"
        description: "\uC190\uD1B1\uB9CC\uD07C \uC791\uC544\uC9C4 \uBAB8\uC73C\uB85C
          \uB0A0\uC544\uC62C\uB790\uC5B4\uC694. \uC801\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74
          \uB0A8\uC740 \uBD88\uC528\uAC00 \uBC18\uB527\uBD88 \uB5BC\uAC00 \uB418\uC5B4
          \uC8FC\uBCC0 \uC801\uB4E4\uC5D0\uAC8C \uC62E\uACA8 \uBD99\uC5B4\uC694.\n\uC801\uC744
          \uC4F0\uB7EC\uB728\uB9AC\uBA74(1.5\uCD08\uC5D0 \uD55C \uBC88\uAE4C\uC9C0)
          \uACF5\uACA9 \uB300\uC0C1 \uC8FC\uBCC0\uC758 \uC801\uC5D0\uAC8C 4\uCD08
          \uB3D9\uC548 \uCD08\uB2F9 \uACF5\uACA9\uB825 80% \uD654\uC0C1 \uD53C\uD574\uB97C
          \uC918\uC694."
