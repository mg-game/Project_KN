    - id: jjak_medic
      name: "\uC591\uB9D0 \uC758\uBB34\uBCD1"
      parentFormId: jjak_base
      tier: 1
      style: 5
      recommendedRole: 0
      description: "\uAD6C\uBA4D \uB09C \uCE5C\uAD6C\uB97C \uBCF4\uBA74 \uADF8\uB0E5
        \uC9C0\uB098\uCE58\uC9C0 \uBABB\uD574\uC11C, \uCEE4\uD504\uC5D0 \uBC14\uB298\uACFC
        \uC2E4\uC744 \uAF42\uACE0 \uB2E4\uB2C8\uAE30 \uC2DC\uC791\uD588\uC5B4\uC694.
        \uC55E\uC136\uC758 \uD328\uCE58\uB294 \uC5B8\uC81C\uB4E0 \uB5BC\uC5B4 \uBD99\uC77C
        \uC218 \uC788\uB294 \uBC18\uCC3D\uACE0 \uCC9C\uC774\uC5D0\uC694.\n\uC9C0\uD0B4\uC774\uB85C
        \uC790\uB9AC\uB97C \uC9C0\uD0A4\uBA70 \uC218\uC120\uC810\uC758 \uCC22\uC5B4\uC9C4
        \uACF3\uC744 \uC8FC\uAE30\uC801\uC73C\uB85C \uAFF0\uB9E4\uACE0, \uD574\uC9C4
        \uC790\uB9AC\uC5D0 \uBC18\uCC3D\uACE0 \uCC9C\uC744 \uB367\uB300 \uCC98\uC74C\uBCF4\uB2E4
        \uD2BC\uD2BC\uD558\uAC8C \uB9CC\uB4E4\uC5B4\uC694."
      portrait: {fileID: 21300000, guid: af355f937c787364fad4e27dc848a1a6, type: 3}
      skill:
        id: skill_jjak_medic
        name: "\uCC9C \uB367\uB300\uAE30"
        description: "\uCEE4\uD504\uC5D0 \uAF42\uC544 \uB454 \uBC14\uB298\uACFC \uBC18\uCC3D\uACE0
          \uCC9C\uC73C\uB85C \uC218\uC120\uC810\uC758 \uCC22\uC5B4\uC9C4 \uACF3\uC744
          \uB367\uB300\uC694. \uD55C \uB540 \uD55C \uB540 \uAE30\uC6B4 \uC790\uB9AC\uB294
          \uCC98\uC74C\uBCF4\uB2E4 \uB354 \uD2BC\uD2BC\uD574\uC694.\n10\uCD08\uB9C8\uB2E4
          \uC218\uC120\uC810 \uB0B4\uAD6C\uB3C4\uB97C \uACF5\uACA9\uB825 300%\uB9CC\uD07C
          \uD68C\uBCF5\uD558\uACE0, \uACF5\uACA9\uB825 150%\uB9CC\uD07C \uD53C\uD574\uB97C
          \uB9C9\uB294 \uBCF4\uD638\uB9C9\uC744 6\uCD08 \uB3D9\uC548 \uC50C\uC6CC\uC694."
        castText: "\uAFF0\uB9E4 \uC904\uAC8C!"
        trigger: 1
        cooldown: 10
        initialDelay: 4
        target: 1
        radius: 0.6
        effects:
        - type: 1
          value: 3
          duration: 0
          count: 0
        - type: 2
          value: 1.5
          duration: 6
          count: 0
        vfx: vfx_patch_heal
