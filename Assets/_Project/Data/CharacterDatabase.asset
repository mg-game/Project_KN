    - id: udu_storm
      name: "\uD3ED\uD48D\uC6B0\uC0B0"
      parentFormId: udu_base
      tier: 1
      style: 2
      recommendedRole: 1
      description: "\uAE30\uB2E4\uB9AC\uB358 \uBE44\uAC00 \uD3ED\uD48D\uC774 \uB418\uC5B4
        \uCC3E\uC544\uC628 \uB0A0, \uB808\uC774\uB2C8\uB294 \uB4A4\uC9D1\uD78C \uC6B0\uC0B0\uCC98\uB7FC
        \uD558\uB298\uC744 \uD5A5\uD574 \uBAB8\uC744 \uD65C\uC9DD \uC5F4\uC5C8\uC5B4\uC694.
        \uD718\uC5B4\uC9C4 \uC0B4 \uC0AC\uC774\uB85C \uBE44\uBC14\uB78C\uC774 \uC18C\uC6A9\uB3CC\uC774\uCCD0\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uD68C\uC624\uB9AC\uCE58\uB294 \uC6B0\uC0B0 \uC18D\uC5D0
        \uC801\uC744 \uD718\uB9D0\uC544, \uC7A0\uC2DC \uADF8 \uC790\uB9AC\uC5D0 \uBD99\uC7A1\uC544
        \uB46C\uC694."
      portrait: {fileID: 21300000, guid: 1c6403285342a454eb6761c7d0dc0a71, type: 3}
      skill:
        id: skill_udu_storm
        name: "\uC18C\uB098\uAE30"
        description: "\uB4A4\uC9D1\uD78C \uC6B0\uC0B0 \uC18D\uC5D0 \uBAA8\uC544 \uB454
          \uBE44\uBC14\uB78C\uC744, \uC18C\uD658\uB418\uC790\uB9C8\uC790 \uD558\uB298
          \uB192\uC774 \uC3D8\uC544 \uC62C\uB824\uC694. \uC628 \uAC70\uB9AC\uC5D0
          \uC18C\uB098\uAE30\uAC00 \uC3DF\uC544\uC9C0\uBA74 \uC801\uB4E4\uC758 \uBC1C\uC774
          \uBB34\uAC70\uC6CC\uC838\uC694.\n\uC794\uD5A5\uC774\uB85C \uC18C\uD658\uB418\uBA74
          \uBAA8\uB4E0 \uC801\uC744 5\uCD08 \uB3D9\uC548 35% \uB290\uB9AC\uAC8C \uB9CC\uB4E4\uACE0,
          \uACF5\uACA9\uB825 60% \uD53C\uD574\uB97C \uC918\uC694."
