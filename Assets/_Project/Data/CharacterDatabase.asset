    - id: jjak_artisan
      name: "\uC591\uB9D0 \uACF5\uBC29\uAC00"
      parentFormId: jjak_postman
      tier: 2
      style: 0
      recommendedRole: 0
      description: "\uD3B8\uC9C0 \uB300\uC2E0, \uC774\uC81C\uB294 \uB9DD\uAC00\uC9C4
        \uBB3C\uAC74\uB4E4\uC774 \uC9DD\uC9DD\uC774\uB97C \uCC3E\uC544\uC640\uC694.
        \uACE8\uBB34 \uD22C\uAD6C\uB97C \uC4F0\uACE0 \uC2E4\uD328\uB97C \uBC29\uD328
        \uC0BC\uC544, \uBAB8\uD1B5\uC5D0 \uBC18\uC9C7\uACE0\uB9AC\uB97C \uB9E4\uB2E8
        \uCC44 \uC791\uC740 \uACF5\uBC29\uC744 \uCC28\uB838\uC9C0\uC694.\n\uC9C0\uD0B4\uC774\uB85C
        \uC11C\uBA74 \uBB34\uC5C7\uC774\uB4E0 \uACE0\uCCD0 \uB0B4\uB294 \uC190\uC7AC\uC8FC\uB85C
        \uBC29\uC704\uB97C \uCD18\uCD18\uD788 \uAFF0\uB9E4\uC5B4, \uC801\uC744 \uB2A6\uCD94\uACE0
        \uB05D\uAE4C\uC9C0 \uBC84\uD168 \uB0B4\uC694."
      portrait: {fileID: 21300000, guid: 57d0365eb9784a2458d185732a514ae7, type: 3}
      skill:
        id: skill_jjak_artisan
        name: "\uCD9C\uBC1C \uC804 \uC190\uC9C8"
        description: "\uD3B8\uC9C0 \uB300\uC2E0 \uB9DD\uAC00\uC9C4 \uBB3C\uAC74\uC744
          \uBC1B\uC544 \uC624\uB358 \uC190\uC7AC\uC8FC\uB85C, \uC804\uD22C\uAC00
          \uC2DC\uC791\uB418\uAE30 \uC804 \uBAA8\uB450\uC758 \uC7A5\uBE44\uB97C \uAF3C\uAF3C\uD788
          \uC190\uBD10\uC694. \uACE8\uBB34 \uD22C\uAD6C \uC544\uB798 \uB208\uBE5B\uC774
          \uBC18\uC9DD\uC5EC\uC694.\n\uC804\uD22C\uAC00 \uC2DC\uC791\uB418\uBA74
          \uBAA8\uB4E0 \uC9C0\uD0B4\uC774\uC758 \uACF5\uACA9\uB825\uC744 30\uCD08
          \uB3D9\uC548 20% \uC62C\uB9AC\uACE0, \uAC78\uB9B0 \uC57D\uD654\uB97C \uC53B\uC5B4
          \uB0B4 30\uCD08 \uB3D9\uC548 \uB2E4\uC2DC \uAC78\uB9AC\uC9C0 \uC54A\uAC8C
          \uD574\uC694."
        castText: "\uB2E4 \uACE0\uCCD0 \uB1A8\uC5B4!"
        trigger: 8
        cooldown: 0
