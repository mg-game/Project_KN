    - id: mong_lantern
      name: "\uCD08\uB871 \uBABD\uC2E4"
      parentFormId: mong_base
      tier: 1
      style: 4
      recommendedRole: 0
      description: "\uBC14\uB78C\uC5D0 \uAEBC\uC9C0\uC9C0 \uC54A\uC73C\uB824\uACE0,
        \uBABD\uC2E4\uC740 \uC885\uC774 \uCD08\uB871 \uC18D\uC5D0 \uB4E4\uC5B4\uAC00
        \uC0B4\uAE30\uB85C \uD588\uC5B4\uC694. \uCD08\uB871\uC758 \uAC00\uB294 \uBF08\uB300\uAC00
        \uAC08\uBE44\uBF08\uAC00 \uB418\uACE0, \uB465\uADFC \uAC13\uC740 \uCEE4\uB2E4\uB780
        \uBA38\uB9AC\uAC00 \uB418\uC5C8\uC9C0\uC694.\n\uC9C0\uD0B4\uC774\uB85C \uC11C\uBA74
        \uAE38 \uC783\uC740 \uCE5C\uAD6C\uB4E4\uC758 \uAE38\uC7A1\uC774\uAC00 \uB418\uC5B4,
        \uC218\uC120\uC810\uC758 \uBD88\uBE5B\uC744 \uBC1B\uC544 \uBA3C \uC5B4\uB460
        \uC18D\uC5D0 \uC228\uC740 \uC801\uAE4C\uC9C0 \uD658\uD788 \uBE44\uCDB0\uC694."
      portrait: {fileID: 21300000, guid: 7d85df1b53781b345b40f57736da63d5, type: 3}
      skill:
        id: skill_mong_lantern
        name: "\uB4F1\uBD88 \uBE5B\uC904\uAE30"
        description: "\uB179\uC544\uB4DC\uB294 \uBE5B\uC744 \uCD08\uB871 \uC548\uC5D0
          \uCC28\uACE1\uCC28\uACE1 \uBAA8\uC544 \uB450\uC5C8\uC5B4\uC694. \uC218\uC120\uC810\uC5D0
          \uBD88\uC774 \uBC1D\uD600\uC9C0\uBA74 \uADF8 \uBE5B\uC744 \uBC1B\uC544
          \uC790\uAE30 \uBC29\uD5A5\uC73C\uB85C \uCEE4\uB2E4\uB780 \uBE5B\uC904\uAE30\uB97C
          \uC3D8\uC544, \uC228\uC5B4 \uC788\uB358 \uC801\uAE4C\uC9C0 \uD658\uD788
          \uBE44\uCDB0\uC694.\n\uC218\uC120\uC810\uC5D0 \uBD88\uC744 \uBC1D\uD788\uBA74
          \uC790\uAE30 \uBC29\uD5A5(\uB808\uC778)\uC758 \uBAA8\uB4E0 \uC801\uC5D0\uAC8C
          \uACF5\uACA9\uB825 400% \uD53C\uD574\uB97C \uC8FC\uACE0, \uC228\uC5B4 \uC788\uB294
          \uC801\uC744 10\uCD08 \uB3D9\uC548 \uB4DC\uB7EC\uB0B4\uACE0, \uD45C\uC2DD\uC744
          \uB0A8\uACA8 8\uCD08 \uB3D9\uC548 \uBC1B\uB294 \uD53C\uD574\uB97C 30% \uB298\uB824\uC694."
        castText: "\uAE38\uC744 \uBC1D\uD600 \uC904\uAC8C!"
