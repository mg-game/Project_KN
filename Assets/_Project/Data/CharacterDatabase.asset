    - id: jjak_alchemist
      name: "\uC591\uB9D0 \uC5F0\uAE08\uC220\uC0AC"
      parentFormId: jjak_medic
      tier: 2
      style: 5
      recommendedRole: 1
      description: "\uC758\uBB34\uBCD1\uC758 \uC57D\uC0C1\uC790\uAC00 \uC5B4\uB290\uC0C8
        \uBC18\uC9DD\uC774\uB294 \uBCD1\uB4E4\uB85C \uAC00\uB4DD \uCC3C\uC5B4\uC694.
        \uC591\uB9D0 \uC18D\uC5D0 \uBCC4\uBE5B \uAC00\uB8E8\uC640 \uCD1B\uB18D, \uAE30\uC5B5\uC758
        \uC2E4\uC744 \uB123\uACE0 \uD754\uB4E4\uBA74 \uB2EC\uCF64\uD55C \uBB18\uC57D\uC774
        \uBCF4\uAE00\uBCF4\uAE00 \uB053\uC5B4\uC62C\uB77C\uC694.\n\uC794\uD5A5\uC774\uB85C
        \uC18C\uD658\uB418\uBA74 \uB2E4\uCE5C \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uBB18\uC57D\uC744
        \uB098\uB220 \uC8FC\uACE0, \uB179 \uAC19\uC740 \uB098\uC05C \uAE30\uC6B4\uC744
        \uB9D0\uB054\uD788 \uC53B\uC5B4 \uB0B4\uC694."
      portrait: {fileID: 21300000, guid: f6f778a4d71623441ac0081020bb58c9, type: 3}
      skill:
        id: skill_jjak_alchemist
        name: "\uB9C8\uC9C0\uB9C9 \uBB18\uC57D"
        description: "\uC758\uBB34\uBCD1 \uC2DC\uC808\uC758 \uC57D\uC0C1\uC790\uAC00
          \uBC18\uC9DD\uC774\uB294 \uBB18\uC57D \uBCD1\uC774 \uB418\uC5C8\uC5B4\uC694.
          \uBE5B\uC73C\uB85C \uD480\uB9AC\uB294 \uC21C\uAC04 \uB9C8\uC9C0\uB9C9 \uBCD1\uC774
          \uAE68\uC9C0\uBA70 \uB2EC\uBE5B \uAC00\uB8E8\uAC00 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C
          \uC3DF\uC544\uC838\uC694.\n\uBE5B\uC73C\uB85C \uD480\uB824 \uC0AC\uB77C\uC9C8
          \uB54C \uBAA8\uB4E0 \uC794\uD5A5\uC774\uC758 \uCCB4\uB825\uC744 \uACF5\uACA9\uB825
          250%\uB9CC\uD07C \uD68C\uBCF5\uD558\uACE0, \uAC78\uB9B0 \uC57D\uD654\uB97C
          \uC53B\uC5B4 \uB0B4 4\uCD08 \uB3D9\uC548 \uB2E4\uC2DC \uAC78\uB9AC\uC9C0
          \uC54A\uAC8C \uD574\uC694."
        castText: "\uD55C \uBAA8\uAE08\uC529 \uB098\uB220 \uB9C8\uC154!"
