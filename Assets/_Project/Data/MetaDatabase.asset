    lineages:
    - lineageId: jjakjjak
      story:
      - "\uC138\uD0C1\uAE30 \uC18D\uC5D0\uC11C \uC9DD\uC744 \uB193\uCE5C \uB0A0\uC744
        \uC544\uC9C1 \uAE30\uC5B5\uD574\uC694."
      - "\uADF8 \uB4A4\uB85C \uB9CC\uB098\uB294 \uC591\uB9D0\uB9C8\uB2E4 '\uAC00\uC871'\uC774\uB77C\uACE0
        \uBD88\uB800\uB300\uC694."
      - "\uC218\uC120\uC810 \uBC14\uAD6C\uB2C8\uC5D0\uC11C \uCC98\uC74C\uC73C\uB85C
        \uD479 \uC7A0\uB4E4\uC5C8\uC5B4\uC694."
      - "\uC783\uC5B4\uBC84\uB9B0 \uC9DD\uB3C4 \uB204\uAD70\uAC00\uC758 \uAC00\uC871\uC774
        \uB418\uC5C8\uAE38 \uBC14\uB77C\uC694."
      - "\uC774\uC81C \uC9DD\uC9DD\uC774\uC5D0\uAC8C \uD55C \uC9DD\uC740 \uC678\uB85C\uC6B4
        \uC22B\uC790\uAC00 \uC544\uB2C8\uC5D0\uC694."
      pet:
      - "\uC624\uB298\uB3C4 \uAC00\uC871\uC774 \uB298\uC5C8\uC5B4!"
      - "\uB0B4 \uC9DD\uC740 \uC5B4\uB514 \uC788\uC744\uAE4C?"
      - "\uAC04\uC9C0\uB7EC\uC6CC, \uD788\uD788!"
      - "\uC218\uC120\uC810\uC740 \uB0B4\uAC00 \uC9C0\uD0AC\uAC8C!"
      - "\uD55C \uC9DD\uC774\uC5B4\uB3C4 \uAD1C\uCC2E\uC544."
      - "\uC2E4\uBC25\uC774 \uD480\uB838\uB098? \uACE0\uB9C8\uC6CC!"
      - "\uB2E4 \uAC19\uC774 \uC788\uC73C\uB2C8 \uC88B\uB2E4~"
    - lineageId: ttokdan
      story:
      - "\uC678\uD22C\uC5D0\uC11C \uB5A8\uC5B4\uC9C0\uB358 \uB0A0, \uB05D\uAE4C\uC9C0
        \uC2E4 \uD55C \uC62C\uC744 \uBD99\uC7A1\uC558\uC5B4\uC694."
      - "\uADF8\uB798\uC11C \uC9C0\uAE08\uB3C4 \uBB34\uC5C7\uC774\uB4E0 \uAF2D \uBD99\uC7A1\uACE0
        \uB193\uC9C0 \uC54A\uC544\uC694."
      - "\uC218\uC120\uC810 \uBB38\uACE0\uB9AC\uB97C \uBD99\uC7A1\uACE0 \uBC24\uC0C8
        \uBB38\uC744 \uC9C0\uD0A8 \uC801\uB3C4 \uC788\uC5B4\uC694."
      - "\uBD99\uC7A1\uB294 \uAC74 \uB193\uCE58\uAE30 \uC2EB\uC740 \uB9C8\uC74C\uC774\uB77C\uB294
        \uAC78 \uC54C\uAC8C \uB410\uC5B4\uC694."
      - "\uC774\uC81C\uB294 \uCE5C\uAD6C\uB4E4 \uC190\uC744 \uAF2D \uBD99\uC7A1\uB294
        \uB2E8\uCD94\uAC00 \uB418\uC5C8\uC5B4\uC694."
      pet:
      - "\uAF2D \uBD99\uC7A1\uACE0 \uC788\uC744\uAC8C!"
      - "\uB193\uCE58\uC9C0 \uC54A\uC544!"
      - "\uB2E8\uB2E8\uD788 \uB9E4\uB2EC\uB838\uC9C0?"
      - "\uC5EC\uAE30\uAC00 \uB0B4 \uC790\uB9AC\uC57C!"
      - "\uB5A8\uC5B4\uC9C0\uBA74 \uC548 \uB3FC\u2026"
      - "\uB538\uAE4D! \uACE0\uB9C8\uC6CC."
      - "\uAF49 \uC7A1\uC544 \uC904\uAC8C!"
    - lineageId: chalkak
      story:
      - "\uB9DE\uB294 \uBB38\uC744 \uCC3E\uC544 \uACE8\uBAA9\uC758 \uBB38\uC744 \uC804\uBD80
        \uB450\uB4DC\uB824 \uBD24\uC5B4\uC694."
      - "\uC5B4\uB290 \uBB38\uB3C4 \uC5F4\uB9AC\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uD3EC\uAE30\uD558\uC9C0
        \uC54A\uC558\uC5B4\uC694."
      - "\uC218\uC120\uC810 \uBB38\uC740 \uB450\uB4DC\uB9AC\uAE30\uB3C4 \uC804\uC5D0
        \uBA3C\uC800 \uC5F4\uB838\uC5B4\uC694."
      - "\uB9DE\uB294 \uC790\uBB3C\uC1E0\uBCF4\uB2E4 \uBC18\uACA8 \uC8FC\uB294 \uBB38\uC774
        \uB354 \uC88B\uB2E4\uB294 \uAC78 \uC54C\uC558\uC5B4\uC694."
      - "\uD0A4\uD0A4\uB294 \uC774\uC81C \uCE5C\uAD6C\uB4E4\uC758 \uB9C8\uC74C\uC744
        \uC5EC\uB294 \uC5F4\uC1E0\uC608\uC694."
      pet:
      - "\uC774 \uBB38\uC740 \uB9DE\uC744\uAE4C?"
      - "\uCC30\uCE75! \uC544\uB2C8\uB124\u2026"
      - "\uC5B8\uC820\uAC00 \uB9DE\uB294 \uBB38\uC774 \uC788\uACA0\uC9C0?"
      - "\uB611\uB611, \uB204\uAD6C\uC138\uC694?"
      - "\uC5B4\uB514\uB4E0 \uC5F4\uC5B4 \uC904\uAC8C!"
      - "\uB531 \uB9DE\uB294 \uC9DD\uC744 \uCC3E\uB294 \uC911!"
      - "\uC5F4\uC1E0 \uAD6C\uBA4D \uAC19\uC740 \uB208\uC774\uB124?"
    - lineageId: mongdang
      story:
      - "\uC0DD\uC77C \uCF00\uC774\uD06C \uC704\uC5D0\uC11C \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0
        \uD0C0\uC624\uB978 \uCD08\uC600\uC5B4\uC694."
      - "\uB179\uC744\uC218\uB85D \uC791\uC544\uC84C\uC9C0\uB9CC \uBE5B\uC740 \uC904\uC9C0
        \uC54A\uC558\uC5B4\uC694."
      - "\uC5B4\uB450\uC6B4 \uC815\uB958\uC7A5\uC5D0\uC11C \uAE38 \uC783\uC740 \uCE5C\uAD6C\uB97C
        \uBC1D\uD600 \uC900 \uC801\uC774 \uC788\uC5B4\uC694."
      - "\uC791\uC544\uC9C0\uB294 \uAC8C \uBB34\uC12D\uC9C0 \uC54A\uB2E4\uACE0, \uC870\uC6A9\uD788
        \uC6C3\uC5B4\uC694."
      - "\uBABD\uC2E4\uC758 \uBD88\uC528\uB294 \uC774\uC81C \uC218\uC120\uC810 \uBAA8\uB450\uC758
        \uB4F1\uBD88\uC774\uC5D0\uC694."
      pet:
      - "\uC870\uAE08 \uC791\uC544\uC84C\uC9C0\uB9CC \uAD1C\uCC2E\uC544."
      - "\uB05D\uAE4C\uC9C0 \uBC1D\uD600 \uC904\uAC8C."
      - "\uB530\uB73B\uD558\uC9C0?"
      - "\uBD88\uC528 \uD558\uB098 \uB098\uB220 \uC904\uAE4C?"
      - "\uB179\uC544\uB3C4 \uBB34\uC12D\uC9C0 \uC54A\uC544."
      - "\uC5B4\uB460\uC740 \uB0B4\uAC00 \uB9E1\uC744\uAC8C!"
      - "\uD638~ \uBD88\uC9C0\uB294 \uB9C8!"
    - lineageId: udukeoni
      story:
      - "\uC8FC\uC778\uC774 '\uAE08\uBC29 \uC62C\uAC8C' \uD558\uACE0 \uB450\uACE0
        \uAC04 \uC6B0\uC0B0\uC774\uC5C8\uC5B4\uC694."
      - "\uB9D1\uC740 \uB0A0\uC774\uBA74 \uC790\uAE30\uAC00 \uC4F8\uBAA8\uC5C6\uB2E4\uACE0
        \uC2DC\uBB34\uB8E9\uD574\uD588\uC5B4\uC694."
      - "\uBE44 \uC624\uB294 \uBC24, \uCE5C\uAD6C\uB4E4\uC744 \uC9C0\uD0A4\uBA70
        \uCC98\uC74C \uC6C3\uC5C8\uC5B4\uC694."
      - "\uAE30\uB2E4\uB9BC\uB3C4 \uB204\uAD70\uAC00\uB97C \uC9C0\uD0A4\uB294 \uC77C\uC774\uB77C\uB294
        \uAC78 \uBC30\uC6E0\uC5B4\uC694."
      - "\uC774\uC81C \uB808\uC774\uB2C8\uB294 \uB9D1\uC740 \uB0A0\uC5D0\uB3C4 \uC218\uC120\uC810\uC744
        \uC9C0\uCF1C\uC694."
      pet:
      - "\uBE44\uAC00 \uC624\uBA74 \uC88B\uACA0\uB2E4\u2026"
      - "\uC624\uB298\uC740 \uB9D1\uB124. \uC2DC\uBB34\uB8E9\u2026"
      - "\uAE30\uB2E4\uB9AC\uB294 \uAC74 \uC790\uC2E0 \uC788\uC5B4."
      - "\uC6B0\uC0B0 \uC544\uB798\uB85C \uC640!"
      - "\uC4F8\uBAA8 \uC788\uB294 \uB0A0\uC774 \uC62C \uAC70\uC57C."
      - "\uBE57\uC18C\uB9AC\uAC00 \uADF8\uB9AC\uC6CC."
      - "\uC8FC\uC778\uC740 \uC5B8\uC81C \uC62C\uAE4C?"
    - lineageId: rouge
      story:
      - "\uC11C\uB78D \uC18D\uC5D0 \uC78A\uD78C \uCC44 \uC624\uB798 \uB69C\uAED1\uC744
        \uB2EB\uACE0 \uC788\uC5C8\uC5B4\uC694."
      - "\uB204\uAD70\uAC00 \uB3CC\uB824 \uC62C\uB824 \uC8FC\uC790 \uCC98\uC74C\uC73C\uB85C
        \uB2F9\uB2F9\uD574\uC84C\uC5B4\uC694."
      - "\uCE5C\uAD6C\uB4E4 \uBCFC\uC5D0 \uD558\uD2B8\uB97C \uADF8\uB824 \uC8FC\uB294
        \uAC8C \uCDE8\uBBF8\uAC00 \uB410\uC5B4\uC694."
      - "\uC218\uC90D\uC740 \uB0A0\uB3C4, \uB2F9\uB2F9\uD55C \uB0A0\uB3C4 \uBAA8\uB450
        \uC790\uAE30 \uBAA8\uC2B5\uC774\uB798\uC694."
      - "\uB8E8\uB8E8\uD31D\uC758 \uC0C9\uC740 \uC774\uC81C \uC218\uC120\uC810\uC758
        \uC6C3\uC74C\uC774\uC5D0\uC694."
      pet:
      - "\uAE84, \uBD80\uB044\uB7EC\uC6CC!"
      - "\uB3CC\uB824 \uC62C\uB9AC\uBA74 \uB2F9\uB2F9\uD574\uC838!"
      - "\uC624\uB298 \uC0C9 \uC5B4\uB54C?"
      - "\uCABD! \uACE0\uB9C8\uC6CC."
      - "\uB69C\uAED1\uC740 \uB2EB\uC9C0 \uB9C8~"
      - "\uBC18\uC9DD\uBC18\uC9DD \uBE5B\uB098 \uBCFC\uAE4C?"
      - "\uB0B4\uAC00 \uC81C\uC77C \uC608\uC058\uC9C0?"
    - lineageId: lalabell
      story:
      - "\uB9C8\uC9C0\uB9C9 \uC74C\uC744 \uCE58\uBA74 \uB178\uB798\uAC00 \uB05D\uB0A0\uAE4C
        \uBD10 \uBB34\uC11C\uC6E0\uC5B4\uC694."
      - "\uADF8\uB798\uC11C \uB298 \uB05D \uC74C \uC55E\uC5D0\uC11C \uBA48\uCDC4\uB300\uC694."
      - "\uCE5C\uAD6C\uB4E4\uC774 \uB2E4\uC74C \uB178\uB798\uB97C \uC774\uC5B4 \uC8FC\uACA0\uB2E4\uACE0
        \uC57D\uC18D\uD588\uC5B4\uC694."
      - "\uCC98\uC74C\uC73C\uB85C \uB9C8\uC9C0\uB9C9 \uC74C\uC744 \uC544\uC8FC \uC791\uAC8C
        \uCCD0 \uBD24\uC5B4\uC694."
      - "\uB05D\uC740 \uB610 \uB2E4\uB978 \uB178\uB798\uC758 \uC2DC\uC791\uC774\uB77C\uB294
        \uAC78 \uC54C\uC558\uC5B4\uC694."
      pet:
      - "\uB9C8\uC9C0\uB9C9 \uC74C\uC740\u2026 \uC544\uC9C1\uC774\uC57C."
      - "\uB3C4, \uB808, \uBBF8\u2026 \uC27F."
      - "\uC790\uC7A5\uAC00 \uB4E4\uB824\uC904\uAE4C?"
      - "\uD0DC\uC5FD\uC744 \uAC10\uC544 \uC904\uB798?"
      - "\uB178\uB798\uAC00 \uB05D\uB098\uB294 \uAC8C \uBB34\uC11C\uC6CC."
      - "\uD568\uAED8\uB77C\uBA74 \uB05D\uAE4C\uC9C0 \uCE60 \uC218 \uC788\uC744\uAE4C?"
      - "\uB775~ \uACE0\uB9C8\uC6CC."
  storyChapters:
  - chapter: 1
    title: "\uBD88\uC774 \uCF1C\uC9C4 \uACE8\uBAA9"
    place: "\uC783\uC5B4\uBC84\uB9B0 \uACE8\uBAA9"
    panels:
    - art: {fileID: 21300000, guid: cd7abff1033149942b32f46513a4c1a0, type: 3}
      text: "\uC78A\uD78C \uBB3C\uAC74\uB4E4\uC774 \uAD74\uB7EC\uB4DC\uB294 \uACE8\uBAA9
        \uB05D, \uC791\uC740 \uC218\uC120\uC810\uC5D0 \uBD88\uC774 \uCF1C\uC84C\uC5B4\uC694."
    - art: {fileID: 21300000, guid: e3df79b6b4370934ba483d784d000344, type: 3}
      text: "\uC9DD\uC744 \uC783\uC740 \uC591\uB9D0\uC774 \uBB38\uC744 \uB450\uB4DC\uB838\uC5B4\uC694.
        \"\uC5EC\uAE30, \uAC00\uC871\uC774 \uC788\uB098\uC694?\""
    - art: {fileID: 21300000, guid: 2ca23a474410a2148bc91088b4ee08f2, type: 3}
      text: "\uD070\uADF8\uB9BC\uC790\uAC00 \uBB3C\uB7EC\uAC04 \uBC24, \uACE8\uBAA9\uC758
        \uAC00\uB85C\uB4F1\uC774 \uD558\uB098\uB458 \uB2E4\uC2DC \uCF1C\uC84C\uC5B4\uC694."
    firstReadRewards:
    - type: 0
      currency: 1
      itemId: 
      amount: 50
  - chapter: 2
    title: "\uBE44 \uC624\uB294 \uAD11\uC7A5\uC758 \uC6B0\uC0B0"
    place: "\uBE44 \uC624\uB294 \uAD11\uC7A5"
    panels:
    - art: {fileID: 21300000, guid: 00d50a09d555df24d8698ea08f0d7fcd, type: 3}
      text: "\uBE44 \uC624\uB294 \uAD11\uC7A5 \uD55C\uAC00\uC6B4\uB370, \uD3BC\uCCD0\uC9C4
        \uC6B0\uC0B0 \uD558\uB098\uAC00 \uC8FC\uC778\uC744 \uAE30\uB2E4\uB838\uC5B4\uC694."
    - art: {fileID: 21300000, guid: 574f8549e72b3bf4fb8140b39e5284fb, type: 3}
      text: "\"\uBE44\uAC00 \uADF8\uCE58\uBA74 \uB098\uB294 \uC4F8\uBAA8\uC5C6\uC5B4\uC9C8\uAE4C?\"
        \uC6B0\uC0B0\uC774 \uC791\uAC8C \uC911\uC5BC\uAC70\uB838\uC5B4\uC694."
    - art: {fileID: 21300000, guid: f88893cae1c488743a047c79589eee56, type: 3}
      text: "\uC218\uC120\uC810 \uC2DD\uAD6C\uB4E4\uC774 \uC6B0\uC0B0 \uC544\uB798
        \uBAA8\uC5EC \uC549\uC790, \uBE57\uC18C\uB9AC\uAC00 \uB178\uB798\uCC98\uB7FC
        \uB4E4\uB838\uC5B4\uC694."
    firstReadRewards:
    - type: 0
      currency: 1
      itemId: 
      amount: 50
  - chapter: 3
    title: "\uB9C8\uC9C0\uB9C9 \uC74C"
    place: "\uBA3C\uC9C0 \uC313\uC778 \uB2E4\uB77D\uBC29"
    panels:
    - art: {fileID: 21300000, guid: 5141fea41af7711449acea6ce2639360, type: 3}
      text: "\uB2E4\uB77D\uBC29 \uC0C1\uC790 \uC18D\uC5D0\uC11C \uB9C8\uC9C0\uB9C9
        \uC74C\uC774 \uACE0\uC7A5 \uB09C \uC624\uB974\uACE8\uC774 \uAE68\uC5B4\uB0AC\uC5B4\uC694."
    - art: {fileID: 21300000, guid: 43907698def8e4649896658498b0a8a9, type: 3}
      text: "\uD0DC\uC5FD\uC744 \uAC10\uC744 \uB54C\uB9C8\uB2E4 \uC624\uB974\uACE8\uC740
        \uB05D \uC74C \uC55E\uC5D0\uC11C \uBA48\uCE6B\uD588\uC5B4\uC694."
    - art: {fileID: 21300000, guid: 6f3c0383ddc5a0048807d6ff4fd5d7ec, type: 3}
      text: "\"\uB05D\uB098\uB3C4 \uAD1C\uCC2E\uC544. \uC6B0\uB9AC\uAC00 \uB2E4\uC74C
        \uB178\uB798\uB97C \uC774\uC5B4 \uC904\uAC8C.\""
    firstReadRewards:
    - type: 0
      currency: 1
      itemId: 
      amount: 50
  - chapter: 4
    title: "\uC11C\uB78D \uC18D \uC0C9"
    place: "\uBD84\uC2E4\uBB3C \uBCF4\uAD00\uC18C"
    panels:
    - art: {fileID: 21300000, guid: d70242cb27fce5b43b4984a0e5f80ca1, type: 3}
      text: "\uC120\uBC18\uB9C8\uB2E4 \uC774\uB984\uD45C \uC5C6\uB294 \uBB3C\uAC74\uB4E4\uC774
        \uBE7C\uACE1\uD55C \uBD84\uC2E4\uBB3C \uBCF4\uAD00\uC18C\uC608\uC694."
    - art: {fileID: 21300000, guid: f369e2606bb6a4547a0c85a4d0890c8a, type: 3}
      text: "\uC11C\uB78D \uC18D \uB9BD\uC2A4\uD2F1\uC774 \uB69C\uAED1\uC744 \uC0B4\uC9DD
        \uC5F4\uACE0 \uBC14\uAE65\uC744 \uC5FF\uBCF4\uC558\uC5B4\uC694."
    - art: {fileID: 21300000, guid: 1e9bd67707a6e7a44b13576b163ac8a7, type: 3}
      text: "\uB3CC\uB824 \uC62C\uB9B0 \uB9BD\uC2A4\uD2F1\uC774 \uBC18\uC9DD \uC6C3\uC790,
        \uBCF4\uAD00\uC18C\uC5D0 \uB2E4\uC815\uD55C \uC0C9\uC774 \uBC88\uC84C\uC5B4\uC694."
    firstReadRewards:
    - type: 0
      currency: 1
      itemId: 
      amount: 50
  - chapter: 5
    title: "\uBCC4\uBE5B \uC138\uD0C1\uC18C"
    place: "\uBCC4\uBE5B \uC138\uD0C1\uC18C"
    panels:
    - art: {fileID: 21300000, guid: 3a79bebbf930d5b42893e48740422f51, type: 3}
      text: "\uBC24\uC5D0\uB9CC \uBB38\uC744 \uC5EC\uB294 \uC138\uD0C1\uC18C\uC5D0\uC11C
        \uBCC4\uBE5B\uC5D0 \uB9C8\uB978 \uCC9C \uB0C4\uC0C8\uAC00 \uB0AC\uC5B4\uC694."
    - art: {fileID: 21300000, guid: 1a795a7d07c487a48a886b077401fe94, type: 3}
      text: "\uBABD\uB2F9\uCD08\uB294 \uB179\uC544 \uC791\uC544\uC838\uB3C4 \uC138\uD0C1\uC18C
        \uAD6C\uC11D\uC744 \uB05D\uAE4C\uC9C0 \uBC1D\uD614\uC5B4\uC694."
    - art: {fileID: 21300000, guid: b6184c24b7e5e394a96411ec24496825, type: 3}
      text: "\uC218\uC120\uC810\uC5D0 \uB3CC\uC544\uC628 \uCE5C\uAD6C\uB4E4\uC774
        \uB9D0\uD588\uC5B4\uC694. \"\uC78A\uD600\uB3C4, \uC6B0\uB9AC\uB294 \uC5EC\uAE30
        \uC788\uC5B4.\""
    firstReadRewards:
    - type: 0
      currency: 1
      itemId: 
      amount: 50
