  returnLines:
  - lineageId: jjakjjak
    lines:
    - "\uBB38 \uC55E \uC591\uB9D0 \uCE5C\uAD6C\uB4E4\uC744 \uBAA8\uB450 \uAC00\uC871\uC774\uB77C
      \uBD88\uB800\uC5B4\uC694"
    - "\uBE68\uB798 \uBC14\uAD6C\uB2C8 \uC18D \uB0AF\uC120 \uC591\uB9D0\uACFC \uD558\uB8FB\uBC24
      \uCE5C\uAD6C\uAC00 \uB410\uC5B4\uC694"
    - "\uD63C\uC790 \uB0A8\uC740 \uC7A5\uAC11 \uD55C \uC9DD \uACC1\uC744 \uBC24\uC0C8
      \uC9C0\uCF1C \uC92C\uC5B4\uC694"
    - "\uAE30\uB2E4\uB9AC\uB294 \uB3D9\uC548 \uC9DD\uAFCD \uC790\uB9AC\uB97C \uAE68\uB057\uC774
      \uBE44\uC6CC \uB480\uC5B4\uC694"
    - "\uBCC4\uC744 \uC138\uB2E4\uAC00 \uC9DD\uC218\uAC00 \uB098\uC624\uBA74 \uAD1C\uD788
      \uAE30\uBED0\uD588\uC5B4\uC694"
    - "\uB3CC\uC544\uC624\uC2DC\uBA74 \uBA3C\uC800 \uC190\uC744 \uD754\uB4E4\uB824\uACE0
      \uBB38 \uC55E\uC5D0 \uC788\uC5C8\uC5B4\uC694"
    - "\uBC14\uB298\uB540 \uB208\uC73C\uB85C \uC719\uD06C \uC5F0\uC2B5\uC744 \uBC31
      \uBC88 \uD588\uC5B4\uC694"
  - lineageId: ttokdan
    lines:
    - "\uD754\uB4E4\uB9AC\uB294 \uBB38\uACE0\uB9AC\uB97C \uBC24\uC0C8 \uAF2D \uBD99\uC7A1\uACE0
      \uC788\uC5C8\uC5B4\uC694"
    - "\uB0A0\uC544\uAC00\uB824\uB358 \uCABD\uC9C0\uB97C \uB124 \uAD6C\uBA4D\uC73C\uB85C
      \uAF49 \uBD99\uB4E4\uC5C8\uC5B4\uC694"
    - "\uB5A8\uC5B4\uC9C4 \uB2E8\uCD94 \uB3D9\uC0DD\uB4E4\uC744 \uD55C \uC904\uB85C
      \uAFF0\uC5B4 \uB370\uB824\uC654\uC5B4\uC694"
    - "\uBC14\uB78C\uC774 \uC138\uAC8C \uBD88\uC5B4\uB3C4 \uC218\uC120\uC810 \uAC04\uD310\uC744
      \uB193\uC9C0 \uC54A\uC558\uC5B4\uC694"
    - "\uC678\uD22C \uC8FC\uBA38\uB2C8 \uC18D \uBE44\uBC00\uC744 \uD558\uB098\uB3C4
      \uD758\uB9AC\uC9C0 \uC54A\uC558\uC5B4\uC694"
    - "\uC878\uB2E4\uAC00\uB3C4 \uC190\uC5D0 \uC954 \uC2E4\uB9CC\uC740 \uB193\uC9C0
      \uC54A\uC558\uB300\uC694"
    - "\uB3CC\uC544\uC624\uC2E4 \uC790\uB9AC\uB97C \uAFB9 \uB20C\uB7EC \uB9E1\uC544
      \uB480\uC5B4\uC694"
  - lineageId: chalkak
    lines:
    - "\uACE8\uBAA9 \uBB38 \uC11C\uB978 \uAC1C\uB97C \uB450\uB4DC\uB824 \uBD24\uC9C0\uB9CC
      \uC544\uC9C1 \uBABB \uCC3E\uC558\uC5B4\uC694"
    - "\uC5F4\uC1E0 \uAD6C\uBA4D\uB9C8\uB2E4 \uAF2C\uBC15\uAF2C\uBC15 \uC778\uC0AC\uB97C
      \uD558\uACE0 \uB2E4\uB154\uC5B4\uC694"
    - "\uB2E4\uB77D\uBC29 \uBB38\uC774 \uC5F4\uB9B4 \uBED4\uD588\uB2E4\uBA70 \uAF2C\uB9AC\uB97C
      \uD754\uB4E4\uC5B4\uC694"
    - "\uC78A\uD78C \uC790\uBB3C\uC1E0\uC758 \uC624\uB798\uB41C \uC774\uC57C\uAE30\uB97C
      \uB4E4\uC5B4 \uC92C\uC5B4\uC694"
    - "\uC794\uD5A5\uC774\uAC00 \uC228\uC5B4 \uC788\uB358 \uC791\uC740 \uD2C8\uC744
      \uBA3C\uC800 \uCC3E\uC544\uB0C8\uC5B4\uC694"
    - "\"\uC774\uBC88\uC5D4 \uC5F4\uB9B4\uC9C0\uB3C4 \uBAB0\uB77C!\" \uD558\uACE0
      \uB610 \uAE38\uC744 \uB098\uC130\uC5B4\uC694"
    - "\uC218\uC120\uC810 \uBB38\uB2E8\uC18D\uC740 \uAC71\uC815 \uB9C8\uC2DC\uB798\uC694"
  - lineageId: mongdang
    lines:
    - "\uCD1B\uB18D\uC774 \uC870\uAE08 \uD758\uB800\uC9C0\uB9CC \uB05D\uAE4C\uC9C0
      \uCC3D\uAC00\uB97C \uBC1D\uD614\uC5B4\uC694"
    - "\uBC14\uB78C \uC18C\uB9AC\uC5D0 \uC6C0\uCE20\uB838\uB2E4\uAC00 \uB2E4\uC2DC
      \uBD88\uAF43\uC744 \uD0A4\uC6E0\uC5B4\uC694"
    - "\uAE38 \uC783\uC740 \uBC18\uB527\uBD88\uC774\uC5D0\uAC8C \uC9D1 \uAC00\uB294
      \uAE38\uC744 \uBE44\uCDB0 \uC92C\uC5B4\uC694"
    - "\uC5B4\uB450\uC6B4 \uACE8\uBAA9 \uB05D\uC5D0 \uC791\uC740 \uBD88\uBE5B\uC744
      \uB0A8\uACA8 \uB450\uC5C8\uC5B4\uC694"
    - "\"\uAD1C\uCC2E\uC544, \uC544\uC9C1 \uC2EC\uC9C0\uAC00 \uB0A8\uC558\uB294\uAC78\"
      \uD558\uACE0 \uC6C3\uC5C8\uC5B4\uC694"
    - "\uD0A4\uB294 \uD55C \uBF18 \uC904\uC5C8\uC9C0\uB9CC \uB9C8\uC74C\uC740 \uD55C
      \uBF18 \uC790\uB790\uB300\uC694"
    - "\uB3CC\uC544\uC624\uC2DC\uB294 \uAE38\uC774 \uC5B4\uB461\uC9C0 \uC54A\uAC8C
      \uAE30\uB2E4\uB838\uC5B4\uC694"
  - lineageId: udukeoni
    lines:
    - "\uBE44\uAC00 \uC548 \uC640\uC11C \uC870\uAE08 \uC2DC\uBB34\uB8E9\uD588\uC5B4\uC694"
    - "\uC6B0\uC0B0\uAF42\uC774\uC5D0 \uC11C\uC11C \uD558\uB298\uB9CC \uC62C\uB824\uB2E4\uBD24\uC5B4\uC694"
