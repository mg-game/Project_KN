    name: "\uD654\uC7A5\uB300\uC758 \uBE44\uBC00"
    description: "\uD654\uC7A5\uB300 \uC11C\uB78D \uC18D, \uB9BD\uC2A4\uD2F1\uACFC
      \uB2E8\uCD94\uB294 \uC624\uB798\uB3C4\uB85D \uC11C\uB85C\uC758 \uBE44\uBC00\uC744
      \uC9C0\uCF1C \uC654\uC5B4\uC694. \uD568\uAED8 \uAFB8\uBBF8\uACE0 \uB098\uC11C\uBA74
      \uB204\uAD6C\uBCF4\uB2E4 \uBC18\uC9DD\uC5EC\uC694.\n\uB8E8\uB8E8\uD31D\uACFC
      \uB611\uB2E8\uC774\uAC00 \uD568\uAED8 \uD3B8\uC131\uB418\uBA74 \uCF1C\uC838\uC694.\n\uCD95\uC81C\uC758
      \uBC24 \uC2A4\uD14C\uC774\uC9C0\uC5D0\uC11C\uB294 \uD6A8\uACFC\uAC00 1.5\uBC30\uAC00
      \uB3FC\uC694."
    kind: 2
    trait: 0
    style: 0
    lineageIds:
    - rouge
    - ttokdan
    tiers:
    - count: 2
      description: "\uBAA8\uB4E0 \uCE5C\uAD6C \uCE58\uBA85\uD0C0 \uD655\uB960 +10%,
        \uCE58\uBA85\uD0C0 \uD53C\uD574 +25% / \uB2E8\uCD94 \xB7 \uC2E4\uD0C0\uB798
        \uD68D\uB4DD\uB7C9 +15%"
      membersOnly: 0
      modifiers:
      - stat: 20
        value: 10
      - stat: 21
        value: 25
      - stat: 22
        value: 15
      bonusSkill:
        id: bonus_combo_vanity_secret
        name: "\uBE44\uBC00\uC758 \uC785\uB9DE\uCDA4"
        description: "\uC801\uC744 \uC4F0\uB7EC\uB728\uB9B0 \uC790\uB9AC\uC5D0\uC11C
          \uC11C\uB78D \uC18D\uC5D0 \uC228\uACA8 \uB454 \uC785\uB9DE\uCDA4 \uC790\uAD6D\uC774
          \uD321 \uD130\uC838, \uACC1\uC758 \uC801\uB4E4\uC5D0\uAC8C \uBD89\uC740
          \uC790\uAD6D\uC744 \uB0A8\uACA8\uC694.\n\uC801\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74(6\uCD08\uC5D0
          \uD55C \uBC88\uAE4C\uC9C0) \uACF5\uACA9 \uB300\uC0C1 \uC8FC\uBCC0\uC758
          \uC801\uC5D0\uAC8C \uACF5\uACA9\uB825 120% \uD53C\uD574\uB97C \uC8FC\uACE0,
          \uD45C\uC2DD\uC744 \uB0A8\uACA8 4\uCD08 \uB3D9\uC548 \uBC1B\uB294 \uD53C\uD574\uB97C
          20% \uB298\uB824\uC694. \uB8E8\uB8E8\uD31D\xB7\uB611\uB2E8\uC774 \uCE5C\uAD6C\uB9C8\uB2E4
          \uB530\uB85C \uC368\uC694."
