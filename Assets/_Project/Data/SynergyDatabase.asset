        name: "\uC62C \uD480\uC5B4 \uAC10\uAE30"
        description: "\uBAB8\uC5D0\uC11C \uD480\uC5B4\uB0B8 \uC62C\uC744 \uD718\uD718
          \uAC10\uC544, \uB2E4\uAC00\uC624\uB294 \uC801\uC758 \uBC1C\uBAA9\uC5D0
          \uC2E4\uD0C0\uB798\uB97C \uC5C9\uACA8 \uBD99\uC5EC\uC694.\n14\uCD08\uB9C8\uB2E4
          \uC694\uACA9 \uBC94\uC704 \uC548\uC758 \uC801\uC744 3\uCD08 \uB3D9\uC548
          40% \uB290\uB9AC\uAC8C \uB9CC\uB4E4\uACE0, \uACF5\uACA9\uB825 100% \uD53C\uD574\uB97C
          \uC918\uC694. \uCC9C \uD2B9\uC131 \uCE5C\uAD6C\uB9C8\uB2E4 \uB530\uB85C
          \uC368\uC694."
        castText: "\uD480\uB824\uB77C, \uC5C9\uCF1C\uB77C!"
        trigger: 1
        cooldown: 14
        initialDelay: 6
        target: 2
