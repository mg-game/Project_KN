    name: "\uB9C8\uC9C0\uB9C9 \uB178\uB798"
    description: "\uB2E4 \uD0C0 \uAC00\uB294 \uCD1B\uBD88 \uC55E\uC5D0\uC11C, \uC5D8\uB9AC\uC81C\uB294
      \uB9C8\uC9C0\uB9C9 \uC74C\uC744 \uC5F0\uC8FC\uD560 \uC6A9\uAE30\uB97C \uC5BB\uC5B4\uC694.
      \uB05D\uC740 \uB610 \uB2E4\uB978 \uC2DC\uC791\uC774\uB2C8\uAE4C\uC694.\n\uC5D8\uB9AC\uC81C\uC640
      \uBABD\uC2E4\uC774 \uD568\uAED8 \uD3B8\uC131\uB418\uBA74 \uCF1C\uC838\uC694.\n\uC815\uC804
      \uC2A4\uD14C\uC774\uC9C0\uC5D0\uC11C\uB294 \uD6A8\uACFC\uAC00 1.5\uBC30\uAC00
      \uB3FC\uC694."
    kind: 2
    trait: 0
    style: 0
    lineageIds:
    - lalabell
    - mongdang
    tiers:
    - count: 2
      description: "\uBAA8\uB4E0 \uCE5C\uAD6C \uC2A4\uD0AC \uCFE8\uD0C0\uC784 -10%
        / \uBD88\uBE5B \uAC8C\uC774\uC9C0 \uCDA9\uC804 +15%, \uBD88 \uBC1D\uD788\uAE30
        \uD53C\uD574 +35%"
