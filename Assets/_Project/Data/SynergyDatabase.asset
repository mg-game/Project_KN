      description: "\uBAA8\uB4E0 \uCE5C\uAD6C \uCCB4\uB825 +20%, \uC794\uD5A5\uC774
        \uC720\uC9C0 \uC2DC\uAC04 +15% / \uC218\uC120\uC810 \uBC1B\uB294 \uD53C\uD574
        -10%"
      membersOnly: 0
