  - id: trait_metal
    name: "\uB2E8\uB2E8\uD55C \uAE08\uC18D"
    description: "\uC5F4\uC1E0 \uD0A4\uD0A4\uC640 \uAE08\uBE5B \uCF00\uC774\uC2A4
      \uB8E8\uB8E8\uD31D\uCC98\uB7FC \uAE08\uC18D\uC73C\uB85C \uB41C \uCE5C\uAD6C\uB4E4\uC774\uC5D0\uC694.
      \uB2E8\uB2E8\uD558\uACE0 \uB0A0\uCE74\uB85C\uC6CC\uC11C, \uC11C\uB85C\uB97C
      \uBE44\uCD94\uBA70 \uC801\uC758 \uC57D\uC810\uC744 \uC815\uD655\uD788 \uCC14\uB7EC\uC694.
      \uB179\uC5BC\uB8E9 \uACC1\uC5D0\uC11C\uB294 \uBAB8\uC774 \uBED1\uBED1\uD574\uC9C0\uB2C8,
      \uD568\uAED8 \uAD11\uD0DD\uC744 \uB0B4 \uB179\uC744 \uB9C9\uC544\uC694."
    kind: 0
    trait: 1
    style: 0
    lineageIds: []
