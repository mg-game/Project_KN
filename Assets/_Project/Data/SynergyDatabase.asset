      bonusSkill:
        id: bonus_combo_last_song
        name: "\uB05D\uB098\uC9C0 \uC54A\uB294 \uC5EC\uC6B4"
        description: "\uC794\uD5A5\uC774\uAC00 \uBE5B\uC73C\uB85C \uD480\uB9AC\uB294
          \uC790\uB9AC\uB9C8\uB2E4 \uB9C8\uC9C0\uB9C9 \uB178\uB798\uC758 \uC5EC\uC6B4\uC774
          \uB0A8\uC544\uC694. \uC5EC\uC6B4\uC5D0 \uB2FF\uC740 \uC801\uB4E4\uC740
          \uB10B\uC744 \uC783\uACE0 \uBA48\uCDB0 \uC11C\uC694.\n\uBE5B\uC73C\uB85C
          \uD480\uB824 \uC0AC\uB77C\uC9C8 \uB54C \uC8FC\uBCC0\uC758 \uC801\uC744
          0.8\uCD08 \uB3D9\uC548 \uAE30\uC808\uC2DC\uD0A4\uACE0, 3\uCD08 \uB3D9\uC548
          30% \uB290\uB9AC\uAC8C \uB9CC\uB4E4\uC5B4\uC694. \uC5D8\uB9AC\uC81C\xB7\uBABD\uC2E4
          \uC794\uD5A5\uC774\uB9C8\uB2E4 \uB530\uB85C \uC368\uC694."
        castText: "\uC774 \uB178\uB798\uB294 \uB05D\uB098\uC9C0 \uC54A\uC544."
