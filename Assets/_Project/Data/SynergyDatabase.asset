  synergies:
  - id: trait_fabric
    name: "\uD3EC\uADFC\uD55C \uCC9C"
    description: "\uC9DD\uC9DD\uC774\xB7\uB611\uB2E8\uC774\xB7\uB808\uC774\uB2C8\uCC98\uB7FC
      \uCC9C\uACFC \uC2E4\uB85C \uC774\uB8E8\uC5B4\uC9C4 \uCE5C\uAD6C\uB4E4\uC774\uC5D0\uC694.
      \uD3ED\uC2E0\uD558\uACE0 \uC9C8\uACA8\uC11C, \uD568\uAED8 \uBAA8\uC77C\uC218\uB85D
      \uD574\uC9C4 \uACF3\uC744 \uC11C\uB85C \uAE30\uC6CC \uC8FC\uBA70 \uC624\uB798
      \uBC84\uD168\uC694. \uCC9C\uC744 \uAC09\uC544\uBA39\uB294 \uC880\uB098\uBC29\uC740
      \uC870\uC2EC\uD558\uC138\uC694!\n\uBA3C\uC9C0 \uD3ED\uD48D \uC2A4\uD14C\uC774\uC9C0\uC5D0\uC11C\uB294
      \uD6A8\uACFC\uAC00 1.5\uBC30\uAC00 \uB3FC\uC694."
    kind: 0
    trait: 0
    style: 0
    lineageIds: []
    tiers:
