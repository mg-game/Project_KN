  zones:
  - id: exp_1_1
    name: "\uC6D0\uC815 1-1"
    place: "\uC783\uC5B4\uBC84\uB9B0 \uACE8\uBAA9"
    description: "\uB204\uAD70\uAC00 \uB5A8\uC5B4\uB728\uB9B0 \uBB3C\uAC74\uB4E4\uC774
      \uBC14\uB78C\uC5D0 \uAD74\uB7EC \uBAA8\uC774\uB294 \uC881\uC740 \uACE8\uBAA9.
