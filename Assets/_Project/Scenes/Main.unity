  _speakerName: "\uC9DD\uC9DD\uC774"
  _gachaTableId: friends
  _pollInterval: 0.25
  _focusSeconds: 3
  _lampWaitText: "\uBD88\uBE5B \uAC8C\uC774\uC9C0\uAC00 \uAC00\uB4DD \uCC28\uBA74
    \uB20C\uB7EC \uC8FC\uC138\uC694"
  _lampKills: 8
  _lampSeconds: 4
  _shortExpeditionToast: "\uCCAB \uC6D0\uC815\uC740 \uAE08\uBC29 \uB3CC\uC544\uC640\uC694!"
  _releasedToast: "\uB2E4\uB978 \uACF3\uB3C4 \uB20C\uB7EC \uBCFC \uC218 \uC788\uC5B4\uC694.
    \uD29C\uD1A0\uB9AC\uC5BC\uC740 \uBA54\uB274 \u203A \uC124\uC815\uC5D0\uC11C \uAC74\uB108\uB6F8
    \uC218 \uC788\uC5B4\uC694."
  _mailHintToast: "\uAC1C\uC5C5 \uC120\uBB3C\uC774 \uC6B0\uD3B8\uD568\uC5D0 \uC640
    \uC788\uC5B4\uC694"
  _mailHintSeconds: 3
  _firstMeetingCardText: "\uCCAB \uB9CC\uB0A8\uC740 \uBB34\uB8CC\uC608\uC694!\n\uBB38\uC744
    \uC5F4\uC5B4 \uB204\uAC00 \uCC3E\uC544\uC654\uB294\uC9C0 \uBD10\uC694"
  _firstMeetingWaitingText: "\uC18C\uD658 \uD0ED\uC5D0\uC11C \uCCAB \uB9CC\uB0A8
    \uCE5C\uAD6C\uAC00 \uAE30\uB2E4\uB824\uC694\n\uBA3C\uC800 \uBB38\uC744 \uC5F4\uC5B4
    \uB9DE\uC774\uD574 \uC8FC\uC138\uC694"
